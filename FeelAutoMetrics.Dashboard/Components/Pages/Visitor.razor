@page "/visitor/{IpAddress}"
@using FeelAutoMetrics.Infrastructure.Data
@using FeelAutoMetrics.Shared.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>FeelAutom-Metrics | Profil Visiteur @IpAddress</PageTitle>

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex align-items-center gap-3 mb-2">
        <a href="/logs" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Retour au flux
        </a>
        <h1 class="h3 text-white mb-0">
            <i class="bi bi-person-badge me-2 text-primary"></i>Profil Visiteur : <span class="font-monospace text-info">@IpAddress</span>
        </h1>
        @if (isBanned)
        {
            <span class="badge bg-danger"><i class="bi bi-slash-circle me-1"></i>Banni</span>
        }
    </div>

    <!-- Robot Suspicion Alert -->
    @if (isSuspiciousBot)
    {
        <div class="alert alert-warning border-warning bg-warning bg-opacity-10 text-warning d-flex align-items-center gap-3 mb-4 shadow-sm">
            <i class="bi bi-robot fs-2"></i>
            <div>
                <h5 class="alert-heading mb-1 fw-bold">Suspicion de Robot détectée</h5>
                <p class="mb-0 small">
                    Ce visiteur présente un comportement non-humain : 
                    <strong>@maxRequestsPerSecond requêtes/sec</strong> détectées à @peakTime. 
                    Navigation ultra-rapide sur @cleanLogs.Count pages en @FormatTimeDiff(TimeSpan.FromSeconds(totalDurationSeconds)).
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="mb-4"></div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <div class="mt-2 text-muted">Analyse du parcours utilisateur...</div>
        </div>
    }
    else if (allLogs.Count == 0)
    {
        <div class="alert alert-dark border-secondary text-center py-5">
            <i class="bi bi-search me-2"></i>Aucun log trouvé pour cette adresse IP.
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Sidebar: Stats & Info -->
            <div class="col-md-3">
                <div class="card bg-dark border-secondary text-white shadow mb-4">
                    <div class="card-header bg-transparent border-secondary py-3">
                        <h5 class="mb-0 small text-uppercase text-muted fw-bold">Informations Clés</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="text-muted small text-uppercase d-block mb-1">Localisation</label>
                            <div class="h6">
                                @if (!string.IsNullOrEmpty(geoInfo?.CountryCode))
                                {
                                    <span class="fw-bold text-primary">@geoInfo.CountryCode</span><span class="mx-1">-</span>@geoInfo.CityName
                                }
                                else
                                {
                                    <span class="text-muted italic">Inconnue</span>
                                }
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small text-uppercase d-block mb-1">Dernier Appareil</label>
                            <div class="h6">
                                <i class="bi @(lastLog?.DeviceFamily == "Mobile" ? "bi-smartphone" : "bi-laptop") me-1"></i>
                                @lastLog?.BrowserName @lastLog?.BrowserVersion
                            </div>
                            <div class="small text-muted">OS: @lastLog?.OsName</div>
                        </div>
                        <hr class="border-secondary" />
                        <div class="row g-2 text-center">
                            <div class="col-6">
                                <div class="bg-black p-2 rounded border border-secondary">
                                    <div class="text-muted small">Requêtes</div>
                                    <div class="h5 mb-0">@allLogs.Count</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="bg-black p-2 rounded border border-secondary">
                                    <div class="text-muted small">Pages Vues</div>
                                    <div class="h5 mb-0 text-success">@cleanLogs.Count</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card bg-dark border-secondary text-white shadow">
                    <div class="card-header bg-transparent border-secondary py-3">
                        <h5 class="mb-0 small text-uppercase text-muted fw-bold">Domaines Visités</h5>
                    </div>
                    <div class="list-group list-group-flush bg-transparent">
                        @foreach (var domain in domains)
                        {
                            <div class="list-group-item bg-transparent border-secondary text-white d-flex justify-content-between align-items-center">
                                <span class="text-truncate small" title="@domain.Key">@domain.Key</span>
                                <span class="badge bg-secondary rounded-pill">@domain.Value</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Timeline: Navigation Path Slider -->
            <div class="col-md-9">
                <div class="card bg-dark border-secondary text-white shadow mb-4">
                    <div class="card-header bg-transparent border-secondary py-3 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-signpost-split me-2 text-primary"></i>Parcours Récent (Dernières pages)</h5>
                        <div class="d-flex align-items-center gap-3">
                            <div class="form-check form-switch small mb-0">
                                <input class="form-check-input" type="checkbox" id="showBruit" @bind="showBruit">
                                <label class="form-check-label text-muted" for="showBruit">Bruit technique</label>
                            </div>
                            <span class="badge bg-secondary">@(showBruit ? allLogs.Count : cleanLogs.Count) étapes</span>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        @{
                            var displayLogs = (showBruit ? allLogs : cleanLogs).Take(50).ToList();
                        }
                        
                        @if (displayLogs.Count == 0)
                        {
                            <div class="text-center text-muted py-4">Aucune page vue détectée.</div>
                        }
                        else
                        {
                            <div class="d-flex overflow-auto pb-3 gap-3" style="scrollbar-width: thin; scrollbar-color: #333 transparent;">
                                @foreach (var (log, index) in displayLogs.Select((l, i) => (l, i)))
                                {
                                    var timeDiff = index < displayLogs.Count - 1 ? (log.Timestamp - displayLogs[index+1].Timestamp) : TimeSpan.Zero;
                                    
                                    <div class="flex-shrink-0" style="width: 220px;">
                                        <div class="card bg-black border-secondary h-100 position-relative shadow-sm overflow-hidden">
                                            <!-- Top indicator -->
                                            <div class="position-absolute top-0 start-0 end-0" style="height: 3px; background: @(log.ResponseStatusCode >= 400 ? "#dc3545" : "#0d6efd")"></div>
                                            
                                            <div class="card-body p-3">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="badge @GetStatusClass(log.ResponseStatusCode) small">@log.ResponseStatusCode</span>
                                                    <span class="text-muted" style="font-size: 0.7rem;">@log.Timestamp.LocalDateTime.ToString("HH:mm:ss")</span>
                                                </div>
                                                
                                                <div class="text-truncate text-primary fw-bold small mb-1" title="@log.RequestHost">@log.RequestHost</div>
                                                <div class="text-white small mb-3 text-wrap" style="word-break: break-all; height: 40px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                                    @log.RequestMethod @log.RequestPath
                                                </div>
                                                
                                                <div class="d-flex align-items-center gap-2 mt-auto">
                                                    <i class="bi @(GetIconForLog(log)) text-muted"></i>
                                                    <span class="text-muted small">@log.DurationMs ms</span>
                                                </div>
                                            </div>
                                            
                                            @if (index < displayLogs.Count - 1 && timeDiff.TotalSeconds > 5)
                                            {
                                                <div class="card-footer bg-transparent border-top-0 py-1 px-3 text-center">
                                                    <span class="text-info" style="font-size: 0.7rem;">
                                                        <i class="bi bi-clock-history me-1"></i>Pause: @FormatTimeDiff(timeDiff)
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    @if (index < displayLogs.Count - 1)
                                    {
                                        <div class="d-flex align-items-center text-secondary">
                                            <i class="bi bi-chevron-right fs-4"></i>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Detailed History Table (Fallback) -->
                <div class="card bg-dark border-secondary text-white shadow">
                    <div class="card-header bg-transparent border-secondary py-3">
                        <h5 class="mb-0"><i class="bi bi-list-ul me-2 text-info"></i>Historique détaillé (Tableau)</h5>
                    </div>
                    <div class="card-body p-0" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-dark table-hover mb-0 small">
                            <thead class="sticky-top bg-dark">
                                <tr class="text-muted small text-uppercase">
                                    <th class="ps-3">Date</th>
                                    <th>Domaine</th>
                                    <th>Path</th>
                                    <th>Status</th>
                                    <th class="text-end pe-3">Durée</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in (showBruit ? allLogs : cleanLogs))
                                {
                                    <tr class="align-middle">
                                        <td class="ps-3 text-muted">@log.Timestamp.LocalDateTime.ToString("HH:mm:ss")</td>
                                        <td class="text-primary fw-bold">@log.RequestHost</td>
                                        <td class="font-monospace @(IsBruit(log) ? "text-muted" : "text-white")">@log.RequestPath</td>
                                        <td><span class="badge @GetStatusClass(log.ResponseStatusCode)">@log.ResponseStatusCode</span></td>
                                        <td class="text-end pe-3">@log.DurationMs ms</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .timeline-item:last-child .timeline-line { display: none; }
    .bg-black { background-color: #080808 !important; }
    .italic { font-style: italic; }
</style>

@code {
    [Parameter] public string IpAddress { get; set; } = "";

    private bool isLoading = true;
    private bool isBanned = false;
    private bool showBruit = false;
    private bool isSuspiciousBot = false;
    private int maxRequestsPerSecond = 0;
    private double totalDurationSeconds = 0;
    private string peakTime = "";
    private List<GlobalAccessLog> allLogs = new();
    private List<GlobalAccessLog> cleanLogs = new();
    private Dictionary<string, int> domains = new();
    private GlobalAccessLog? lastLog;
    private GlobalAccessLog? geoInfo;

    protected override async Task OnInitializedAsync()
    {
        await LoadVisitorData();
    }

    private async Task LoadVisitorData()
    {
        isLoading = true;
        using var context = await DbFactory.CreateDbContextAsync();

        // Check ban status
        isBanned = await context.BannedIps.AnyAsync(b => b.IpAddress == IpAddress && b.IsActive);

        // Load all logs for this IP (last 500)
        allLogs = await context.GlobalAccessLogs
            .Where(l => l.ClientHost == IpAddress)
            .OrderByDescending(l => l.Timestamp)
            .Take(500)
            .ToListAsync();

        if (allLogs.Count > 0)
        {
            lastLog = allLogs.First();
            geoInfo = allLogs.FirstOrDefault(l => !string.IsNullOrEmpty(l.CountryCode));
            
            // Filter domains
            domains = allLogs.GroupBy(l => l.RequestHost)
                .Select(g => new { Host = g.Key, Count = g.Count() })
                .OrderByDescending(x => x.Count)
                .ToDictionary(x => x.Host, x => x.Count);

            // Clean noise
            cleanLogs = allLogs.Where(l => !IsBruit(l)).ToList();

            // Analyse de suspicion de robot
            AnalyzeRobotBehavior();
        }

        isLoading = false;
    }

    private void AnalyzeRobotBehavior()
    {
        if (allLogs.Count < 2) return;

        // 1. Calcul de la durée totale
        var first = allLogs.Last().Timestamp;
        var last = allLogs.First().Timestamp;
        totalDurationSeconds = (last - first).TotalSeconds;

        // 2. Détection du pic de requêtes par seconde
        var perSecond = allLogs.GroupBy(l => l.Timestamp.ToString("yyyy-MM-dd HH:mm:ss"))
            .Select(g => new { Time = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .FirstOrDefault();

        if (perSecond != null)
        {
            maxRequestsPerSecond = perSecond.Count;
            peakTime = perSecond.Time.Split(' ')[1];
        }

        // 3. Critères de suspicion
        // - Plus de 5 requêtes dans la même seconde
        // - OU Plus de 20 pages vues en moins de 10 secondes
        if (maxRequestsPerSecond >= 5 || (cleanLogs.Count > 10 && totalDurationSeconds < 5))
        {
            isSuspiciousBot = true;
        }
    }

    private bool IsBruit(GlobalAccessLog log)
    {
        var path = log.RequestPath.ToLower();
        return path.Contains("/_next/") || 
               path.Contains("/_rsc=") || 
               path.EndsWith(".js") || 
               path.EndsWith(".css") || 
               path.EndsWith(".png") || 
               path.EndsWith(".jpg") || 
               path.EndsWith(".jpeg") || 
               path.EndsWith(".svg") || 
               path.EndsWith(".woff2") || 
               path.EndsWith(".ico") || 
               path.Contains("/favicon") ||
               path.Contains("/api/logs/ingest");
    }

    private string GetIconForLog(GlobalAccessLog log)
    {
        if (log.ResponseStatusCode >= 500) return "bi-bug-fill";
        if (log.ResponseStatusCode >= 400) return "bi-exclamation-octagon";
        if (log.RequestMethod == "POST") return "bi-send-fill";
        if (IsBruit(log)) return "bi-gear";
        return "bi-file-earmark-text";
    }

    private string GetStatusClass(int status) => status switch
    {
        >= 200 and < 300 => "bg-success",
        >= 300 and < 400 => "bg-info",
        >= 400 and < 500 => "bg-warning",
        >= 500 => "bg-danger",
        _ => "bg-secondary"
    };

    private string FormatTimeDiff(TimeSpan diff)
    {
        if (diff.TotalMinutes >= 60) return $"{(int)diff.TotalHours}h";
        if (diff.TotalMinutes >= 1) return $"{(int)diff.TotalMinutes}m";
        return $"{(int)diff.TotalSeconds}s";
    }
}

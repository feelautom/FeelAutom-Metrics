@page "/visitor/{IpAddress}"
@using FeelAutoMetrics.Infrastructure.Data
@using FeelAutoMetrics.Shared.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>FeelAutom-Metrics | Profil Visiteur @IpAddress</PageTitle>

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex align-items-center gap-3 mb-2">
        <a href="/logs" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Retour au flux
        </a>
        <h1 class="h3 text-white mb-0">
            <i class="bi bi-person-badge me-2 text-primary"></i>Profil Visiteur : <span class="font-monospace text-info">@IpAddress</span>
        </h1>
        @if (isBanned)
        {
            <a href="/security/@IpAddress" class="badge bg-danger text-decoration-none" title="Voir les détails dans le SOC">
                <i class="bi bi-slash-circle me-1"></i>Banni
            </a>
        }
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <div class="mt-2 text-muted">Analyse du parcours utilisateur...</div>
        </div>
    }
    else if (allLogs.Count == 0)
    {
        <div class="alert alert-dark border-secondary text-center py-5">
            <i class="bi bi-search me-2"></i>Aucun log trouvé pour cette adresse IP.
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Sidebar: Stats & Info -->
            <div class="col-md-3">
                <!-- Robot Suspicion Alert (Moved here) -->
                @if (isSuspiciousBot)
                {
                    <div class="card border-warning bg-warning bg-opacity-10 text-warning shadow mb-4">
                        <div class="card-body p-3 d-flex gap-3 align-items-center">
                            <i class="bi bi-robot fs-3"></i>
                            <div>
                                <h6 class="mb-1 fw-bold">Suspicion de Robot</h6>
                                <p class="mb-0 x-small" style="font-size: 0.75rem;">
                                    <strong>@maxRequestsPerSecond req/s</strong> détectées.
                                    Parcours ultra-rapide.
                                </p>
                            </div>
                        </div>
                    </div>
                }

                <div class="card bg-dark border-secondary text-white shadow mb-4">
                    <div class="card-header bg-transparent border-secondary py-3">
                        <h5 class="mb-0 small text-uppercase text-muted fw-bold">Informations Clés</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="text-muted small text-uppercase d-block mb-1">Localisation</label>
                            <div class="h6">
                                @if (!string.IsNullOrEmpty(geoInfo?.CountryCode))
                                {
                                    <span class="fw-bold text-primary">@geoInfo.CountryCode</span><span class="mx-1">-</span>@geoInfo.CityName
                                }
                                else
                                {
                                    <span class="text-muted italic">Inconnue</span>
                                }
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small text-uppercase d-block mb-1">Dernier Appareil</label>
                            <div class="h6">
                                <i class="bi @(lastLog?.DeviceFamily == "Mobile" ? "bi-smartphone" : "bi-laptop") me-1"></i>
                                @lastLog?.BrowserName @lastLog?.BrowserVersion
                            </div>
                            <div class="small text-muted">OS: @lastLog?.OsName</div>
                        </div>
                        <hr class="border-secondary" />
                        <div class="row g-2 text-center">
                            <div class="col-6">
                                <div class="bg-black p-2 rounded border border-secondary">
                                    <div class="text-muted small">Requêtes</div>
                                    <div class="h5 mb-0">@allLogs.Count</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="bg-black p-2 rounded border border-secondary">
                                    <div class="text-muted small">Pages Vues</div>
                                    <div class="h5 mb-0 text-success">@cleanLogs.Count</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card bg-dark border-secondary text-white shadow">
                    <div class="card-header bg-transparent border-secondary py-3">
                        <h5 class="mb-0 small text-uppercase text-muted fw-bold">Domaines Visités</h5>
                    </div>
                    <div class="list-group list-group-flush bg-transparent">
                        @foreach (var domain in domains)
                        {
                            <div class="list-group-item bg-transparent border-secondary text-white d-flex justify-content-between align-items-center">
                                <span class="text-truncate small" title="@domain.Key">@domain.Key</span>
                                <span class="badge bg-secondary rounded-pill">@domain.Value</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Timeline: Navigation Path Paged Slider -->
            <div class="col-md-9">
                <div class="card bg-dark border-secondary text-white shadow mb-4">
                    <div class="card-header bg-transparent border-secondary py-3 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-signpost-split me-2 text-primary"></i>
                            @(showBruit ? "Flux complet" : "Parcours épuré") 
                            <span class="badge bg-secondary ms-2" style="font-size: 0.7rem; font-weight: normal;">
                                @displayLogs.Count @(showBruit ? "requêtes" : "étapes")
                            </span>
                        </h5>
                        <div class="d-flex align-items-center gap-3">
                            <div class="form-check form-switch small mb-0">
                                <input class="form-check-input" type="checkbox" id="showBruit" 
                                       @bind="showBruit" @bind:after="ResetTimelinePage">
                                <label class="form-check-label text-muted" for="showBruit" title="Masquer/Afficher les assets, prefetch, etc.">Bruit technique</label>
                            </div>
                            <div class="btn-group">
                                <button class="btn btn-outline-secondary btn-sm" @onclick="PrevTimelinePage" disabled="@(currentTimelinePage == 0)">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                                <span class="btn btn-outline-secondary btn-sm disabled text-white">
                                    @(currentTimelinePage + 1) / @Math.Max(1, (int)Math.Ceiling((double)displayLogs.Count / 6))
                                </span>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="NextTimelinePage" disabled="@((currentTimelinePage + 1) * 6 >= displayLogs.Count)">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4 bg-black bg-opacity-25" style="min-height: 500px;">
                        @{
                            var pagedLogs = displayLogs.Skip(currentTimelinePage * 6).Take(6).ToList();
                        }
                        
                        <div class="timeline">
                            @if (pagedLogs.Count == 0)
                            {
                                <div class="text-center text-muted py-4">Aucune étape à afficher sur cette page.</div>
                            }
                            else
                            {
                                @foreach (var (log, index) in pagedLogs.Select((l, i) => (l, i)))
                                {
                                    var globalIndex = (currentTimelinePage * 6) + index;
                                    var timeDiff = globalIndex < displayLogs.Count - 1 ? (log.Timestamp - displayLogs[globalIndex + 1].Timestamp) : TimeSpan.Zero;
                                    var isNoise = IsBruit(log);

                                    <div class="timeline-item pb-4 position-relative @(isNoise ? "opacity-50" : "")">
                                        @if (index < pagedLogs.Count - 1 || (currentTimelinePage + 1) * 6 < displayLogs.Count)
                                        {
                                            <div class="timeline-line position-absolute" style="left: 15px; top: 30px; bottom: 0; width: 2px; background: #333;"></div>
                                        }

                                        
                                        <div class="d-flex">
                                            <div class="timeline-dot rounded-circle @(isNoise ? "bg-secondary" : "bg-primary") shadow-sm" style="width: 32px; height: 32px; flex-shrink: 0; z-index: 2; display: flex; align-items: center; justify-content: center;">
                                                <i class="bi @(GetIconForLog(log)) text-white small"></i>
                                            </div>
                                            
                                            <div class="ms-3 w-100">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <span class="badge bg-secondary opacity-75 mb-1">@log.RequestHost</span>
                                                        @if (isNoise)
                                                        {
                                                            <span class="badge bg-dark text-muted border border-secondary ms-1" style="font-size: 0.6rem;">BRUIT</span>
                                                        }
                                                        <h6 class="mb-1 @(log.ResponseStatusCode >= 400 ? "text-danger" : isNoise ? "text-muted" : "text-white")">
                                                            @log.RequestMethod @log.RequestPath
                                                        </h6>
                                                    </div>
                                                    <div class="text-end">
                                                        <div class="small text-white">@log.Timestamp.LocalDateTime.ToString("HH:mm:ss")</div>
                                                        <div class="small text-muted">@log.Timestamp.LocalDateTime.ToString("dd MMM yyyy")</div>
                                                    </div>
                                                </div>
                                                
                                                <div class="d-flex align-items-center gap-2 mt-1">
                                                    <span class="badge @GetStatusClass(log.ResponseStatusCode) btn-sm">@log.ResponseStatusCode</span>
                                                    <span class="text-muted small"><i class="bi bi-clock me-1"></i>@log.DurationMs ms</span>
                                                    @if (timeDiff.TotalSeconds > 5)
                                                    {
                                                        <span class="text-info small ms-auto bg-info bg-opacity-10 px-2 rounded">
                                                            <i class="bi bi-hourglass-split me-1"></i>Pause de @FormatTimeDiff(timeDiff)
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .timeline-item:last-child .timeline-line { display: none; }
    .bg-black { background-color: #080808 !important; }
    .italic { font-style: italic; }
</style>

@code {
    [Parameter] public string IpAddress { get; set; } = "";

    private bool isLoading = true;
    private bool isBanned = false;
    private bool showBruit = false;
    private bool isSuspiciousBot = false;
    private int maxRequestsPerSecond = 0;
    private double totalDurationSeconds = 0;
    private string peakTime = "";
    private int currentTimelinePage = 0;
    private List<GlobalAccessLog> allLogs = new();
    private List<GlobalAccessLog> cleanLogs = new();
    private List<GlobalAccessLog> displayLogs => showBruit ? allLogs : cleanLogs;
    private Dictionary<string, int> domains = new();
    private GlobalAccessLog? lastLog;
    private GlobalAccessLog? geoInfo;

    protected override async Task OnInitializedAsync()
    {
        await LoadVisitorData();
    }

    private void NextTimelinePage()
    {
        if ((currentTimelinePage + 1) * 6 < displayLogs.Count) currentTimelinePage++;
    }

    private void PrevTimelinePage()
    {
        if (currentTimelinePage > 0) currentTimelinePage--;
    }

    private void ResetTimelinePage()
    {
        currentTimelinePage = 0;
    }

    private async Task LoadVisitorData()
    {
        isLoading = true;
        using var context = await DbFactory.CreateDbContextAsync();

        // Check ban status
        isBanned = await context.BannedIps.AnyAsync(b => b.IpAddress == IpAddress && b.IsActive);

        // Load all logs for this IP (last 500)
        allLogs = await context.GlobalAccessLogs
            .Where(l => l.ClientHost == IpAddress)
            .OrderByDescending(l => l.Timestamp)
            .Take(500)
            .ToListAsync();

        if (allLogs.Count > 0)
        {
            lastLog = allLogs.First();
            geoInfo = allLogs.FirstOrDefault(l => !string.IsNullOrEmpty(l.CountryCode));
            
            // Filter domains
            domains = allLogs.GroupBy(l => l.RequestHost)
                .Select(g => new { Host = g.Key, Count = g.Count() })
                .OrderByDescending(x => x.Count)
                .ToDictionary(x => x.Host, x => x.Count);

            // Clean noise
            cleanLogs = allLogs.Where(l => !IsBruit(l)).ToList();

            // Analyse de suspicion de robot
            AnalyzeRobotBehavior();
        }

        isLoading = false;
    }

    private void AnalyzeRobotBehavior()
    {
        if (allLogs.Count < 2) return;

        // 1. Calcul de la durée totale
        var first = allLogs.Last().Timestamp;
        var last = allLogs.First().Timestamp;
        totalDurationSeconds = (last - first).TotalSeconds;

        // 2. Détection du pic de requêtes par seconde
        var perSecond = allLogs.GroupBy(l => l.Timestamp.ToString("yyyy-MM-dd HH:mm:ss"))
            .Select(g => new { Time = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .FirstOrDefault();

        if (perSecond != null)
        {
            maxRequestsPerSecond = perSecond.Count;
            peakTime = perSecond.Time.Split(' ')[1];
        }

        // 3. Critères de suspicion
        // - Plus de 5 requêtes dans la même seconde
        // - OU Plus de 20 pages vues en moins de 10 secondes
        if (maxRequestsPerSecond >= 5 || (cleanLogs.Count > 10 && totalDurationSeconds < 5))
        {
            isSuspiciousBot = true;
        }
    }

    private bool IsBruit(GlobalAccessLog log)
    {
        var path = log.RequestPath.ToLower();
        return path.Contains("/_next/") || 
               path.Contains("/_rsc=") || 
               path.EndsWith(".js") || 
               path.EndsWith(".css") || 
               path.EndsWith(".png") || 
               path.EndsWith(".jpg") || 
               path.EndsWith(".jpeg") || 
               path.EndsWith(".svg") || 
               path.EndsWith(".woff2") || 
               path.EndsWith(".ico") || 
               path.Contains("/favicon") ||
               path.Contains("/api/logs/ingest");
    }

    private string GetIconForLog(GlobalAccessLog log)
    {
        if (log.ResponseStatusCode >= 500) return "bi-bug-fill";
        if (log.ResponseStatusCode >= 400) return "bi-exclamation-octagon";
        if (log.RequestMethod == "POST") return "bi-send-fill";
        if (IsBruit(log)) return "bi-gear";
        return "bi-file-earmark-text";
    }

    private string GetStatusClass(int status) => status switch
    {
        >= 200 and < 300 => "bg-success",
        >= 300 and < 400 => "bg-info",
        >= 400 and < 500 => "bg-warning",
        >= 500 => "bg-danger",
        _ => "bg-secondary"
    };

    private string FormatTimeDiff(TimeSpan diff)
    {
        if (diff.TotalMinutes >= 60) return $"{(int)diff.TotalHours}h";
        if (diff.TotalMinutes >= 1) return $"{(int)diff.TotalMinutes}m";
        return $"{(int)diff.TotalSeconds}s";
    }
}

@page "/"
@using FeelAutoMetrics.Infrastructure.Data
@using FeelAutoMetrics.Shared.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@rendermode InteractiveServer

<PageTitle>FeelAuto-Metrics | Dashboard Global</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="h2 text-white fw-bold">Observabilité Globale</h1>
            <p class="text-muted mb-0">Surveillance en temps réel de votre infrastructure et applications.</p>
        </div>
        <div class="text-end">
            <span class="badge bg-success p-2 px-3">En Ligne</span>
            <div class="small text-muted mt-1">Dernière synchro : @DateTime.Now.ToString("HH:mm:ss")</div>
        </div>
    </div>

    @if (stats == null)
    {
        <div class="text-center py-5">
            <div class="spinner-grow text-primary" role="status">
                <span class="visually-hidden">Initialisation...</span>
            </div>
        </div>
    }
    else
    {
        <!-- KPI Row -->
        <div class="row g-4 mb-5">
            <div class="col-md-3">
                <div class="card bg-dark text-white border-0 shadow h-100">
                    <div class="card-body p-4 border-start border-primary border-4 rounded-end">
                        <h6 class="text-muted text-uppercase small fw-bold">Trafic Global (24h)</h6>
                        <h2 class="mb-0 fw-bold">@stats.TotalRequests.ToString("N0")</h2>
                        <div class="small text-primary mt-2">Requêtes via Traefik</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-dark text-white border-0 shadow h-100">
                    <div class="card-body p-4 border-start border-warning border-4 rounded-end">
                        <h6 class="text-muted text-uppercase small fw-bold">Taux d'Erreurs</h6>
                        <h2 class="mb-0 fw-bold text-warning">@stats.ErrorRate.ToString("P1")</h2>
                        <div class="small text-muted mt-2">Codes HTTP 4xx/5xx</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-dark text-white border-0 shadow h-100">
                    <div class="card-body p-4 border-start border-info border-4 rounded-end">
                        <h6 class="text-muted text-uppercase small fw-bold">Latence Moyenne</h6>
                        <h2 class="mb-0 fw-bold text-info">@stats.AverageLatency.ToString("N0") <small>ms</small></h2>
                        <div class="small text-muted mt-2">Réponse globale</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-dark text-white border-0 shadow h-100">
                    <div class="card-body p-4 border-start border-danger border-4 rounded-end">
                        <h6 class="text-muted text-uppercase small fw-bold">Alertes Sécurité</h6>
                        <h2 class="mb-0 fw-bold text-danger">@stats.SecurityAlerts</h2>
                        <div class="small text-muted mt-2">Menaces détectées</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Recent Activity -->
            <div class="col-lg-8">
                <div class="card bg-dark text-white border-0 shadow h-100">
                    <div class="card-header bg-transparent border-secondary py-3">
                        <h5 class="mb-0">Derniers Événements Applicatifs</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-dark table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Application</th>
                                        <th>Niveau</th>
                                        <th>Message</th>
                                        <th>Heure</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ev in recentEvents)
                                    {
                                        <tr>
                                            <td><span class="badge bg-info">@ev.AppName</span></td>
                                            <td><span class="badge @GetLevelClass(ev.Level)">@ev.Level</span></td>
                                            <td class="text-truncate" style="max-width: 300px;">@ev.Message</td>
                                            <td class="small text-muted">@ev.Timestamp.LocalDateTime.ToString("HH:mm")</td>
                                        </tr>
                                    }
                                    @if (!recentEvents.Any())
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center py-4 text-muted small">Aucun événement applicatif reçu pour le moment.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 text-end">
                        <a href="/logs" class="btn btn-link btn-sm text-primary">Voir tous les logs <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>

            <!-- Domains Breakdown -->
            <div class="col-lg-4">
                <div class="card bg-dark text-white border-0 shadow h-100">
                    <div class="card-header bg-transparent border-secondary py-3">
                        <h5 class="mb-0">Répartition par Domaine</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var d in domainBreakdown)
                        {
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="small">@d.Key</span>
                                    <span class="small fw-bold">@d.Value.ToString("N0")</span>
                                </div>
                                <div class="progress bg-secondary" style="height: 6px;">
                                    <div class="progress-bar bg-primary" style="width: @GetDomainPercentage(d.Value)%"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private GlobalStats? stats;
    private List<AppEvent> recentEvents = new();
    private Dictionary<string, int> domainBreakdown = new();
    private int maxDomainRequests = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadStats();
    }

    private async Task LoadStats()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        
        var totalReq = await context.GlobalAccessLogs.CountAsync();
        if (totalReq == 0) 
        {
            stats = new GlobalStats();
            return;
        }

        var avgLat = await context.GlobalAccessLogs.AverageAsync(l => l.DurationMs);
        var errors = await context.GlobalAccessLogs.CountAsync(l => l.ResponseStatusCode >= 400);
        var threats = await context.GlobalAccessLogs.CountAsync(l => l.IsBot && l.BotCategory == "ThreatScanner");

        stats = new GlobalStats
        {
            TotalRequests = totalReq,
            AverageLatency = avgLat,
            ErrorRate = (double)errors / totalReq,
            SecurityAlerts = threats
        };

        recentEvents = await context.AppEvents
            .OrderByDescending(e => e.Timestamp)
            .Take(8)
            .ToListAsync();

        domainBreakdown = await context.GlobalAccessLogs
            .GroupBy(l => l.RequestHost)
            .Select(g => new { g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .Take(5)
            .ToDictionaryAsync(x => x.Key, x => x.Count);

        maxDomainRequests = domainBreakdown.Values.FirstOrDefault();
    }

    private string GetLevelClass(string level) => level switch
    {
        "Error" or "Critical" => "bg-danger",
        "Warning" => "bg-warning text-dark",
        _ => "bg-success"
    };

    private double GetDomainPercentage(int count) => (double)count / maxDomainRequests * 100;

    private class GlobalStats
    {
        public int TotalRequests { get; set; }
        public double AverageLatency { get; set; }
        public double ErrorRate { get; set; }
        public int SecurityAlerts { get; set; }
    }
}

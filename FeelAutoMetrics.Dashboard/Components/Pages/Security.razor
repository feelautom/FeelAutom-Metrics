@page "/security"
@page "/security/{PreSelectedIp}"
@using FeelAutoMetrics.Infrastructure.Data
@using FeelAutoMetrics.Shared.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IConfiguration Config
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>FeelAutom-Metrics | Sécurité (SOC)</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 text-danger"><i class="bi bi-shield-lock-fill me-2"></i>Security Operations Center (SOC)</h1>
            <p class="text-muted mb-0">Détection globale des menaces et gestion des bannissements.</p>
        </div>
        <span class="text-muted small"><i class="bi bi-arrow-repeat me-1"></i>Auto-refresh 30s</span>
    </div>

    @if (threats == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-danger" role="status">
                <span class="visually-hidden">Analyse en cours...</span>
            </div>
        </div>
    }
    else
    {
        <!-- KPIs -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-dark border-danger text-white shadow">
                    <div class="card-body">
                        <h6 class="card-title text-uppercase small text-muted">IPs Suspectes</h6>
                        <h2 class="mb-0">@threats.Select(t => t.ClientHost).Distinct().Count()</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-dark border-warning text-white shadow">
                    <div class="card-body">
                        <h6 class="card-title text-uppercase small text-muted">Tentatives d'Intrusion</h6>
                        <h2 class="mb-0">@totalThreats.ToString("N0")</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-dark border-info text-white shadow">
                    <div class="card-body">
                        <h6 class="card-title text-uppercase small text-muted">IPs Bannies</h6>
                        <h2 class="mb-0">@bannedIps.Count</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-dark border-primary text-white shadow">
                    <div class="card-body">
                        <h6 class="card-title text-uppercase small text-muted">Analyses IA</h6>
                        <h2 class="mb-0">@aiAnalyses.Count</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabs -->
        <ul class="nav nav-tabs border-secondary mb-0">
            <li class="nav-item">
                <button class="nav-link @(activeTab == "threats" ? "active text-danger" : "text-muted")"
                        @onclick='() => activeTab = "threats"'>
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>Menaces
                    <span class="badge bg-danger ms-1">@totalThreats.ToString("N0")</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == "bans" ? "active text-info" : "text-muted")"
                        @onclick='() => activeTab = "bans"'>
                    <i class="bi bi-slash-circle me-1"></i>Bans
                    <span class="badge bg-info ms-1">@bannedIps.Count</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == "scores" ? "active text-warning" : "text-muted")"
                        @onclick='() => activeTab = "scores"'>
                    <i class="bi bi-speedometer2 me-1"></i>Scores
                    @if (threatScores.Any())
                    {
                        <span class="badge bg-warning text-dark ms-1">@threatScores.Count</span>
                    }
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == "ai" ? "active text-primary" : "text-muted")"
                        @onclick='() => activeTab = "ai"'>
                    <i class="bi bi-robot me-1"></i>AI Analyst
                    @if (aiAnalyses.Any())
                    {
                        <span class="badge bg-primary ms-1">@aiAnalyses.Count</span>
                    }
                </button>
            </li>
        </ul>

        <div class="card bg-dark border-secondary text-white shadow border-top-0" style="border-top-left-radius: 0; border-top-right-radius: 0;">
            <div class="card-body p-0">

                @* ===== TAB: MENACES ===== *@
                @if (activeTab == "threats")
                {
                    <!-- Search -->
                    <div class="p-3 border-bottom border-secondary">
                        <div class="row g-2 align-items-center">
                            <div class="col-md-6">
                                <div class="input-group">
                                    <span class="input-group-text bg-black border-secondary text-muted"><i class="bi bi-search"></i></span>
                                    <input type="text" class="form-control bg-black border-secondary text-white"
                                           placeholder="Rechercher par IP, domaine, path, type de menace..."
                                           @bind="searchTerm" @bind:event="oninput"
                                           @onkeydown="HandleSearchKeyDown" />
                                    @if (!string.IsNullOrEmpty(searchTerm))
                                    {
                                        <button class="btn btn-outline-secondary" @onclick="ClearSearch">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="col-md-2">
                                <button class="btn btn-danger w-100" @onclick="DoSearch">
                                    <i class="bi bi-search me-1"></i>Rechercher
                                </button>
                            </div>
                        </div>
                    </div>

                    @if (totalThreats > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Cible (Domaine)</th>
                                        <th>Attaquant (IP)</th>
                                        <th>Type</th>
                                        <th>Requête Suspecte</th>
                                        <th>Origine</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in threats)
                                    {
                                        var isBanned = bannedSet.Contains(t.ClientHost);
                                        <tr class="align-middle @(isBanned ? "opacity-50" : "")">
                                            <td class="small text-muted">@t.Timestamp.LocalDateTime.ToString("dd/MM HH:mm:ss")</td>
                                            <td><span class="badge bg-secondary opacity-75">@t.RequestHost</span></td>
                                            <td class="font-monospace fw-bold @(isBanned ? "text-muted" : "text-danger")" style="cursor: pointer;" @onclick="() => ViewIpProfile(t.ClientHost)">
                                                @t.ClientHost
                                                <i class="bi bi-box-arrow-up-right ms-1 small opacity-50"></i>
                                                @if (isBanned)
                                                {
                                                    <span class="badge bg-danger ms-2">banni</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge @GetThreatBadgeClass(t.ThreatType)">@(t.ThreatType ?? "ThreatBot")</span>
                                            </td>
                                            <td class="text-truncate" style="max-width: 300px;">
                                                <code class="text-warning bg-transparent p-0">@t.RequestPath</code>
                                            </td>
                                            <td class="text-light">@t.CountryName</td>
                                            <td class="text-end">
                                                @if (!isBanned)
                                                {
                                                    <button class="btn btn-danger btn-sm" @onclick="() => BanIp(t.ClientHost, t.RequestPath)">
                                                        <i class="bi bi-slash-circle me-1"></i>Bannir
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <div class="d-flex justify-content-between align-items-center p-3 border-top border-secondary">
                            <div class="text-muted small">
                                Page @currentPage / @totalPages — Affichage @((currentPage - 1) * pageSize + 1)-@Math.Min(currentPage * pageSize, totalThreats) sur @totalThreats.ToString("N0")
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-secondary btn-sm" disabled="@(currentPage <= 1)" @onclick="FirstPage">
                                    <i class="bi bi-chevron-double-left"></i>
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" disabled="@(currentPage <= 1)" @onclick="PrevPage">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    var p = i;
                                    <button class="btn btn-sm @(p == currentPage ? "btn-danger" : "btn-outline-secondary")" @onclick="() => GoToPage(p)">
                                        @p
                                    </button>
                                }
                                <button class="btn btn-outline-secondary btn-sm" disabled="@(currentPage >= totalPages)" @onclick="NextPage">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" disabled="@(currentPage >= totalPages)" @onclick="LastPage">
                                    <i class="bi bi-chevron-double-right"></i>
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>Aucune menace active détectée.
                        </div>
                    }
                }

                @* ===== TAB: BANS ===== *@
                @if (activeTab == "bans")
                {
                    @if (selectedIpProfile != null)
                    {
                        <!-- Profil IP détaillé -->
                        <div class="p-3 border-bottom border-secondary d-flex align-items-center gap-2">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="CloseIpProfile">
                                <i class="bi bi-arrow-left me-1"></i>Retour
                            </button>
                            <h5 class="mb-0 text-danger font-monospace">@selectedIpProfile</h5>
                            @if (ipProfileBan != null)
                            {
                                <span class="badge bg-danger">Banni x@(ipProfileBan.BanCount)</span>
                            }
                        </div>

                        <!-- KPIs IP -->
                        <div class="row g-3 p-3">
                            <div class="col-md-3">
                                <div class="card bg-black border-secondary text-white">
                                    <div class="card-body py-2">
                                        <div class="text-muted small">Total requêtes</div>
                                        <div class="h5 mb-0">@ipProfileTotalHits.ToString("N0")</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-black border-danger text-white">
                                    <div class="card-body py-2">
                                        <div class="text-muted small">Requêtes suspectes</div>
                                        <div class="h5 mb-0 text-danger">@ipProfileSuspiciousHits.ToString("N0")</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-black border-secondary text-white">
                                    <div class="card-body py-2">
                                        <div class="text-muted small">Première vue</div>
                                        <div class="h6 mb-0">@(ipProfileFirstSeen?.LocalDateTime.ToString("dd/MM/yy HH:mm") ?? "-")</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-black border-secondary text-white">
                                    <div class="card-body py-2">
                                        <div class="text-muted small">Dernière vue</div>
                                        <div class="h6 mb-0">@(ipProfileLastSeen?.LocalDateTime.ToString("dd/MM/yy HH:mm") ?? "-")</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Infos GeoIP + Ban -->
                        <div class="row g-3 px-3 pb-3">
                            <div class="col-md-6">
                                <div class="card bg-black border-secondary text-white h-100">
                                    <div class="card-header bg-transparent border-secondary small text-muted">
                                        <i class="bi bi-geo-alt me-1"></i>Localisation
                                    </div>
                                    <div class="card-body py-2">
                                        @if (ipProfileGeo != null)
                                        {
                                            <div>@(ipProfileGeo.CountryName ?? "Inconnu") @(!string.IsNullOrEmpty(ipProfileGeo.CityName) ? $"— {ipProfileGeo.CityName}" : "")</div>
                                        }
                                        else
                                        {
                                            <div class="text-muted">Non disponible</div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card bg-black border-secondary text-white h-100">
                                    <div class="card-header bg-transparent border-secondary small text-muted">
                                        <i class="bi bi-shield-exclamation me-1"></i>Historique des bans
                                    </div>
                                    <div class="card-body py-2">
                                        @if (ipProfileBan != null)
                                        {
                                            var origin = GetBanOrigin(ipProfileBan.Reason);
                                            <div class="mb-2">
                                                <span class="badge @origin.Color">
                                                    <i class="bi @origin.Icon me-1"></i>@origin.Label
                                                </span>
                                                <span class="ms-2"><strong>@ipProfileBan.BanCount</strong> ban(s)</span>
                                            </div>
                                            <div class="small text-muted">Dernier ban : @ipProfileBan.BannedAt.LocalDateTime.ToString("dd/MM/yy HH:mm")</div>
                                            <div class="small text-muted">Raison : @(ipProfileBan.Reason ?? "-")</div>
                                            @if (ipProfileBan.ExpiresAt != null)
                                            {
                                                <div class="small text-muted">Expire : @ipProfileBan.ExpiresAt.Value.LocalDateTime.ToString("dd/MM/yy HH:mm")</div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="text-muted">Aucun ban enregistré</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Domaines ciblés -->
                        @if (ipProfileDomains.Any())
                        {
                            <div class="px-3 pb-3">
                                <div class="card bg-black border-secondary text-white">
                                    <div class="card-header bg-transparent border-secondary small text-muted">
                                        <i class="bi bi-globe me-1"></i>Domaines ciblés
                                    </div>
                                    <div class="card-body py-2 d-flex flex-wrap gap-2">
                                        @foreach (var d in ipProfileDomains)
                                        {
                                            <span class="badge bg-secondary">@d.Domain <span class="text-warning">(@d.Count)</span></span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Types de menaces -->
                        @if (ipProfileThreatTypes.Any())
                        {
                            <div class="px-3 pb-3">
                                <div class="card bg-black border-secondary text-white">
                                    <div class="card-header bg-transparent border-secondary small text-muted">
                                        <i class="bi bi-exclamation-triangle me-1"></i>Types de menaces
                                    </div>
                                    <div class="card-body py-2 d-flex flex-wrap gap-2">
                                        @foreach (var t in ipProfileThreatTypes)
                                        {
                                            <span class="badge @GetThreatBadgeClass(t.Type)">@t.Type <span class="opacity-75">(@t.Count)</span></span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Dernières requêtes suspectes -->
                        @if (ipProfileLogs.Any())
                        {
                            <div class="px-3 pb-3">
                                <div class="card bg-black border-secondary text-white">
                                    <div class="card-header bg-transparent border-secondary small text-muted">
                                        <i class="bi bi-list-ul me-1"></i>Dernières requêtes suspectes (@ipProfileSuspiciousHits total)
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-dark table-hover mb-0 small">
                                            <thead>
                                                <tr>
                                                    <th>Date</th>
                                                    <th>Domaine</th>
                                                    <th>Méthode</th>
                                                    <th>Path</th>
                                                    <th>Status</th>
                                                    <th>Type</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var log in ipProfileLogs)
                                                {
                                                    <tr>
                                                        <td class="text-muted">@log.Timestamp.LocalDateTime.ToString("dd/MM HH:mm:ss")</td>
                                                        <td><span class="badge bg-secondary opacity-75">@log.RequestHost</span></td>
                                                        <td class="text-info">@log.RequestMethod</td>
                                                        <td class="text-truncate" style="max-width: 350px;"><code class="text-warning bg-transparent p-0">@log.RequestPath</code></td>
                                                        <td>
                                                            <span class="badge @(log.ResponseStatusCode >= 400 ? "bg-danger" : "bg-success")">@log.ResponseStatusCode</span>
                                                        </td>
                                                        <td><span class="badge @GetThreatBadgeClass(log.ThreatType)">@(log.ThreatType ?? "-")</span></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Action -->
                        <div class="p-3 d-flex justify-content-end">
                            @if (ipProfileBan?.IsActive == true)
                            {
                                <button class="btn btn-outline-success" @onclick="() => UnbanIp(selectedIpProfile!)">
                                    <i class="bi bi-unlock-fill me-1"></i>Débannir
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-danger" @onclick="() => BanFromProfile()">
                                    <i class="bi bi-slash-circle me-1"></i>Bannir
                                </button>
                            }
                        </div>
                    }
                    else if (bannedIps.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Adresse IP</th>
                                        <th>Origine</th>
                                        <th>Récidive</th>
                                        <th>Raison</th>
                                        <th>Durée</th>
                                        <th>Expire le</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ban in bannedIps)
                                    {
                                        var origin = GetBanOrigin(ban.Reason);
                                        <tr class="align-middle" style="cursor: pointer;" @onclick="() => OpenIpProfile(ban.IpAddress)">
                                            <td class="font-monospace text-danger fw-bold">
                                                @ban.IpAddress
                                                <i class="bi bi-box-arrow-up-right ms-1 small opacity-50"></i>
                                            </td>
                                            <td>
                                                <span class="badge @origin.Color">
                                                    <i class="bi @origin.Icon me-1"></i>@origin.Label
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge @(ban.BanCount >= 3 ? "bg-danger" : ban.BanCount >= 2 ? "bg-warning text-dark" : "bg-secondary")">
                                                    x@(ban.BanCount)
                                                </span>
                                            </td>
                                            <td class="text-muted small" style="max-width: 300px;">@(ban.Reason ?? "-")</td>
                                            <td>
                                                @if (ban.ExpiresAt == null)
                                                {
                                                    <span class="badge bg-danger">Permanent</span>
                                                }
                                                else
                                                {
                                                    var days = (ban.ExpiresAt.Value - ban.BannedAt).TotalDays;
                                                    var label = days <= 1 ? "24h" : days <= 7 ? "7j" : "30j";
                                                    <span class="badge bg-warning text-dark">@label</span>
                                                }
                                            </td>
                                            <td class="small text-muted">
                                                @if (ban.ExpiresAt != null)
                                                {
                                                    @ban.ExpiresAt.Value.LocalDateTime.ToString("dd/MM à HH:mm")
                                                }
                                                else
                                                {
                                                    <span>-</span>
                                                }
                                            </td>
                                            <td class="text-end" @onclick:stopPropagation="true">
                                                <button class="btn btn-outline-success btn-sm" @onclick="() => UnbanIp(ban.IpAddress)">
                                                    <i class="bi bi-unlock-fill me-1"></i>Débannir
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>Aucune IP bannie actuellement.
                        </div>
                    }
                }

                @* ===== TAB: SCORES ===== *@
                @if (activeTab == "scores")
                {
                    @if (threatScores.Any())
                    {
                        <div class="p-3 border-bottom border-secondary">
                            <span class="text-muted small"><i class="bi bi-info-circle me-1"></i>Seuil auto-ban : 200 pts — les IPs ci-dessous accumulent des points suspects.</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-dark table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Adresse IP</th>
                                        <th>Score</th>
                                        <th style="min-width: 180px;">Jauge</th>
                                        <th>Première vue</th>
                                        <th>Dernier hit</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in threatScores)
                                    {
                                        var pct = Math.Min(100, (int)(s.Score / 200.0 * 100));
                                        var barColor = pct >= 75 ? "bg-danger" : pct >= 50 ? "bg-warning" : "bg-info";
                                        <tr class="align-middle">
                                            <td class="font-monospace fw-bold text-warning">@s.IpAddress</td>
                                            <td>
                                                <span class="badge @(pct >= 75 ? "bg-danger" : pct >= 50 ? "bg-warning text-dark" : "bg-info")">
                                                    @s.Score / 200
                                                </span>
                                            </td>
                                            <td>
                                                <div class="progress bg-black" style="height: 8px;">
                                                    <div class="progress-bar @barColor" style="width: @(pct)%"></div>
                                                </div>
                                            </td>
                                            <td class="small text-muted">@s.FirstSeen.LocalDateTime.ToString("dd/MM HH:mm")</td>
                                            <td class="small text-muted">@s.LastHit.LocalDateTime.ToString("dd/MM HH:mm:ss")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>Aucun score de menace en cours.
                        </div>
                    }
                }

                @* ===== TAB: AI ANALYST ===== *@
                @if (activeTab == "ai")
                {
                    @if (aiAnalyses.Any())
                    {
                        <div>
                            @{
                                var aiPageItems = aiAnalyses.Skip((aiCurrentPage - 1) * aiPageSize).Take(aiPageSize).ToList();
                            }
                            @foreach (var (analysis, index) in aiPageItems.Select((a, i) => (a, i)))
                            {
                                var idx = (aiCurrentPage - 1) * aiPageSize + index;
                                var isOpen = expandedAiIndex == idx;
                                <div class="border-bottom border-secondary">
                                    <button class="btn btn-link w-100 text-start text-decoration-none py-2 px-3 d-flex align-items-center"
                                            style="background: transparent;"
                                            @onclick="() => ToggleAiAccordion(idx)">
                                        <div class="d-flex align-items-center gap-3 w-100">
                                            <span class="badge @(analysis.ActionsTaken > 0 ? "bg-danger" : "bg-success") rounded-pill">
                                                @analysis.ActionsTaken ban@(analysis.ActionsTaken != 1 ? "s" : "")
                                            </span>
                                            <span class="small text-muted">
                                                @analysis.AnalyzedAt.LocalDateTime.ToString("dd/MM HH:mm")
                                            </span>
                                            <span class="small text-light">
                                                @analysis.LogsAnalyzed logs analysés
                                                <span class="text-muted ms-1">
                                                    (@analysis.LogsFromTimestamp.LocalDateTime.ToString("HH:mm") → @analysis.LogsToTimestamp.LocalDateTime.ToString("HH:mm"))
                                                </span>
                                            </span>
                                            <i class="bi @(isOpen ? "bi-chevron-up" : "bi-chevron-down") ms-auto text-muted"></i>
                                        </div>
                                    </button>
                                    @if (isOpen)
                                    {
                                        <div class="bg-black border-top border-secondary p-3">
                                            <pre class="mb-0 text-light small" style="white-space: pre-wrap; font-family: inherit;">@analysis.Summary</pre>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Pagination AI -->
                        @if (aiTotalPages > 1)
                        {
                            <div class="d-flex justify-content-between align-items-center p-3 border-top border-secondary">
                                <div class="text-muted small">
                                    Page @aiCurrentPage / @aiTotalPages — @aiAnalyses.Count analyses
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-outline-secondary btn-sm" disabled="@(aiCurrentPage <= 1)" @onclick="() => AiGoToPage(1)">
                                        <i class="bi bi-chevron-double-left"></i>
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm" disabled="@(aiCurrentPage <= 1)" @onclick="() => AiGoToPage(aiCurrentPage - 1)">
                                        <i class="bi bi-chevron-left"></i>
                                    </button>
                                    @for (int i = aiStartPage; i <= aiEndPage; i++)
                                    {
                                        var p = i;
                                        <button class="btn btn-sm @(p == aiCurrentPage ? "btn-primary" : "btn-outline-secondary")" @onclick="() => AiGoToPage(p)">
                                            @p
                                        </button>
                                    }
                                    <button class="btn btn-outline-secondary btn-sm" disabled="@(aiCurrentPage >= aiTotalPages)" @onclick="() => AiGoToPage(aiCurrentPage + 1)">
                                        <i class="bi bi-chevron-right"></i>
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm" disabled="@(aiCurrentPage >= aiTotalPages)" @onclick="() => AiGoToPage(aiTotalPages)">
                                        <i class="bi bi-chevron-double-right"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-4 text-center">
                            @if (aiEnabled == true)
                            {
                                <div class="text-success">
                                    <i class="bi bi-check-circle-fill me-2"></i>AI Analyst activé (toutes les @aiInterval min) — en attente de la première analyse...
                                </div>
                            }
                            else if (aiEnabled == false)
                            {
                                <div class="text-danger">
                                    <i class="bi bi-x-circle-fill me-2"></i><code>GEMINI_API_KEY</code> non configurée sur l'Ingestor — AI Analyst désactivé.
                                </div>
                            }
                            else
                            {
                                <div class="text-muted">
                                    <i class="bi bi-robot me-2"></i>
                                    @if (aiStatusError != null)
                                    {
                                        <span class="text-warning">@aiStatusError</span>
                                    }
                                    else
                                    {
                                        <span>Vérification du statut AI Analyst...</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                }

            </div>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1050;">
        <div class="toast show bg-dark border-@statusClass text-white shadow-lg">
            <div class="toast-body">
                <i class="bi @statusIcon me-2"></i>@statusMessage
            </div>
        </div>
    </div>
}

<style>
    .nav-tabs .nav-link {
        border: none;
        border-bottom: 2px solid transparent;
        background: transparent;
        padding: 0.75rem 1.25rem;
        transition: all 0.2s;
    }
    .nav-tabs .nav-link:hover {
        border-bottom-color: #555;
        color: #fff !important;
    }
    .nav-tabs .nav-link.active {
        background: transparent;
        border-bottom-width: 2px;
        border-bottom-style: solid;
        font-weight: 600;
    }
    .nav-tabs .nav-link.text-danger.active { border-bottom-color: var(--bs-danger); }
    .nav-tabs .nav-link.text-info.active { border-bottom-color: var(--bs-info); }
    .nav-tabs .nav-link.text-warning.active { border-bottom-color: var(--bs-warning); }
    .nav-tabs .nav-link.text-primary.active { border-bottom-color: var(--bs-primary); }
</style>

@code {
    private List<GlobalAccessLog>? threats;
    private List<BannedIp> bannedIps = new();
    private List<IpThreatScore> threatScores = new();
    private List<AiAnalysis> aiAnalyses = new();
    private HashSet<string> bannedSet = new();
    private Timer? _refreshTimer;
    private string? statusMessage;
    private string statusClass = "success";
    private string statusIcon = "bi-check-circle-fill";
    private string searchTerm = "";
    private string activeTab = "threats";
    private bool? aiEnabled;
    private string aiInterval = "15";
    private string? aiStatusError;
    private int? expandedAiIndex = 0;

    // Pagination AI
    private int aiCurrentPage = 1;
    private int aiPageSize = 10;
    private int aiTotalPages => (int)Math.Ceiling((double)aiAnalyses.Count / aiPageSize);
    private int aiStartPage => Math.Max(1, aiCurrentPage - 2);
    private int aiEndPage => Math.Min(aiTotalPages, aiStartPage + 4);

    // Pagination
    private int currentPage = 1;
    private int pageSize = 100;
    private int totalThreats;
    private int totalPages => (int)Math.Ceiling((double)totalThreats / pageSize);
    private int startPage => Math.Max(1, currentPage - 2);
    private int endPage => Math.Min(totalPages, startPage + 4);

    [Parameter] public string? PreSelectedIp { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await CheckAiStatus();

        if (!string.IsNullOrEmpty(PreSelectedIp))
        {
            activeTab = "bans";
            await OpenIpProfile(PreSelectedIp);
        }

        _refreshTimer = new Timer(async _ =>
        {
            await LoadData();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task CheckAiStatus()
    {
        try
        {
            var baseUrl = Config["IngestorBaseUrl"] ?? "http://ingestor:8080";
            var ingestorKey = Config["IngestorApiKey"] ?? "";
            using var http = new HttpClient { Timeout = TimeSpan.FromSeconds(5) };
            if (!string.IsNullOrEmpty(ingestorKey))
                http.DefaultRequestHeaders.Add("X-Api-Key", ingestorKey);
            var response = await http.GetAsync($"{baseUrl}/api/ai/status");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                using var doc = System.Text.Json.JsonDocument.Parse(json);
                aiEnabled = doc.RootElement.GetProperty("enabled").GetBoolean();
                aiInterval = doc.RootElement.GetProperty("intervalMinutes").GetString() ?? "15";
            }
            else
            {
                aiStatusError = $"Ingestor HTTP {(int)response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            aiStatusError = $"Ingestor injoignable : {ex.Message}";
        }
    }

    private async Task LoadData()
    {
        using var context = await DbFactory.CreateDbContextAsync();

        var excludedIps = await context.ExcludedIps.Select(e => e.IpAddress).ToListAsync();
        IQueryable<GlobalAccessLog> baseQuery = context.GlobalAccessLogs;
        if (excludedIps.Any())
            baseQuery = baseQuery.Where(l => !excludedIps.Contains(l.ClientHost));

        // Exclure les IPs bannies de la liste des menaces
        var bannedIpList = await context.BannedIps
            .Where(b => b.IsActive)
            .Select(b => b.IpAddress)
            .ToListAsync();

        var query = baseQuery
            .Where(l => l.IsSuspicious && !bannedIpList.Contains(l.ClientHost));

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.Trim();
            query = query.Where(l =>
                l.ClientHost.Contains(term) ||
                l.RequestHost.Contains(term) ||
                l.RequestPath.Contains(term) ||
                (l.ThreatType != null && l.ThreatType.Contains(term)) ||
                (l.CountryName != null && l.CountryName.Contains(term)));
        }

        totalThreats = await query.CountAsync();

        threats = await query
            .OrderByDescending(l => l.Timestamp)
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToListAsync();

        // Désactiver les bans expirés
        var expired = await context.BannedIps
            .Where(b => b.IsActive && b.ExpiresAt != null && b.ExpiresAt < DateTimeOffset.UtcNow)
            .ToListAsync();
        if (expired.Any())
        {
            foreach (var b in expired) b.IsActive = false;
            await context.SaveChangesAsync();
        }

        bannedIps = await context.BannedIps
            .Where(b => b.IsActive)
            .OrderByDescending(b => b.BannedAt)
            .ToListAsync();

        bannedSet = bannedIps.Select(b => b.IpAddress).ToHashSet();

        threatScores = await context.IpThreatScores
            .OrderByDescending(s => s.Score)
            .Take(50)
            .ToListAsync();

        aiAnalyses = await context.AiAnalyses
            .OrderByDescending(a => a.AnalyzedAt)
            .Take(100)
            .ToListAsync();
    }

    private async Task BanIp(string ip, string? path)
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var existing = await context.BannedIps.FirstOrDefaultAsync(b => b.IpAddress == ip);

        if (existing != null && existing.IsActive)
        {
            await ShowStatus($"{ip} est déjà banni.", "warning", "bi-exclamation-triangle-fill");
            return;
        }

        if (existing != null)
        {
            existing.BanCount++;
            existing.IsActive = true;
            existing.Reason = $"Manuel: {path}";
            existing.BannedAt = DateTimeOffset.UtcNow;
            existing.ExpiresAt = existing.BanCount switch
            {
                1 => DateTimeOffset.UtcNow.AddDays(1),
                2 => DateTimeOffset.UtcNow.AddDays(7),
                _ => DateTimeOffset.UtcNow.AddDays(30)
            };
        }
        else
        {
            context.BannedIps.Add(new BannedIp
            {
                IpAddress = ip,
                Reason = $"Manuel: {path}",
                ExpiresAt = DateTimeOffset.UtcNow.AddDays(1)
            });
        }

        await context.SaveChangesAsync();
        await LoadData();
        await ShowStatus($"{ip} banni (24h).", "danger", "bi-slash-circle");
    }

    private async Task UnbanIp(string ip)
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var ban = await context.BannedIps.FirstOrDefaultAsync(b => b.IpAddress == ip && b.IsActive);
        if (ban != null)
        {
            ban.IsActive = false;
            await context.SaveChangesAsync();
        }
        await LoadData();
        await ShowStatus($"{ip} a été débanni.", "success", "bi-unlock-fill");
    }

    private async Task ShowStatus(string message, string cssClass, string icon)
    {
        statusMessage = message;
        statusClass = cssClass;
        statusIcon = icon;
        StateHasChanged();
        await Task.Delay(3000);
        statusMessage = null;
        StateHasChanged();
    }

    private static string GetThreatBadgeClass(string? type) => type switch
    {
        "DirectIpScan" => "bg-danger",
        "PathScan" => "bg-warning text-dark",
        "SuspiciousExtension" => "bg-warning text-dark",
        "PathTraversal" => "bg-danger",
        "SQLInjection" => "bg-danger",
        "XSS" => "bg-danger",
        "Error500Burst" => "bg-danger",
        "RequestBurst" => "bg-warning text-dark",
        "ThreatBot" => "bg-info",
        _ => "bg-secondary"
    };

    private (string Label, string Color, string Icon) GetBanOrigin(string? reason)
    {
        if (string.IsNullOrEmpty(reason)) return ("Système", "bg-secondary", "bi-cpu");
        if (reason.StartsWith("AI:", StringComparison.OrdinalIgnoreCase)) return ("Analyste IA", "bg-primary", "bi-robot");
        if (reason.StartsWith("Manuel", StringComparison.OrdinalIgnoreCase)) return ("Manuel", "bg-info text-dark", "bi-person-fill");
        return ("Automatique", "bg-warning text-dark", "bi-shield-shaded");
    }

    private void ToggleAiAccordion(int index)
    {
        expandedAiIndex = expandedAiIndex == index ? null : index;
    }

    private void AiGoToPage(int page)
    {
        aiCurrentPage = Math.Max(1, Math.Min(page, aiTotalPages));
        expandedAiIndex = null;
    }

    // IP Profile
    private string? selectedIpProfile;
    private BannedIp? ipProfileBan;
    private int ipProfileTotalHits;
    private int ipProfileSuspiciousHits;
    private DateTimeOffset? ipProfileFirstSeen;
    private DateTimeOffset? ipProfileLastSeen;
    private GlobalAccessLog? ipProfileGeo;
    private List<(string Domain, int Count)> ipProfileDomains = new();
    private List<(string Type, int Count)> ipProfileThreatTypes = new();
    private List<GlobalAccessLog> ipProfileLogs = new();

    private async Task OpenIpProfile(string ip)
    {
        selectedIpProfile = ip;
        using var context = await DbFactory.CreateDbContextAsync();

        ipProfileBan = await context.BannedIps.FirstOrDefaultAsync(b => b.IpAddress == ip);

        ipProfileTotalHits = await context.GlobalAccessLogs.CountAsync(l => l.ClientHost == ip);
        ipProfileSuspiciousHits = await context.GlobalAccessLogs.CountAsync(l => l.ClientHost == ip && l.IsSuspicious);

        ipProfileFirstSeen = await context.GlobalAccessLogs
            .Where(l => l.ClientHost == ip)
            .OrderBy(l => l.Timestamp)
            .Select(l => (DateTimeOffset?)l.Timestamp)
            .FirstOrDefaultAsync();

        ipProfileLastSeen = await context.GlobalAccessLogs
            .Where(l => l.ClientHost == ip)
            .OrderByDescending(l => l.Timestamp)
            .Select(l => (DateTimeOffset?)l.Timestamp)
            .FirstOrDefaultAsync();

        ipProfileGeo = await context.GlobalAccessLogs
            .Where(l => l.ClientHost == ip && l.CountryName != null)
            .OrderByDescending(l => l.Timestamp)
            .FirstOrDefaultAsync();

        ipProfileDomains = await context.GlobalAccessLogs
            .Where(l => l.ClientHost == ip && l.IsSuspicious)
            .GroupBy(l => l.RequestHost)
            .Select(g => new { Domain = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .Take(20)
            .ToListAsync()
            .ContinueWith(t => t.Result.Select(x => (x.Domain, x.Count)).ToList());

        ipProfileThreatTypes = await context.GlobalAccessLogs
            .Where(l => l.ClientHost == ip && l.IsSuspicious && l.ThreatType != null)
            .GroupBy(l => l.ThreatType!)
            .Select(g => new { Type = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .ToListAsync()
            .ContinueWith(t => t.Result.Select(x => (x.Type, x.Count)).ToList());

        ipProfileLogs = await context.GlobalAccessLogs
            .Where(l => l.ClientHost == ip && l.IsSuspicious)
            .OrderByDescending(l => l.Timestamp)
            .Take(50)
            .ToListAsync();
    }

    private void CloseIpProfile()
    {
        selectedIpProfile = null;
    }

    private async Task BanFromProfile()
    {
        if (selectedIpProfile != null)
            await BanIp(selectedIpProfile, "Manuel depuis profil");
    }

    private async Task ViewIpProfile(string ip)
    {
        activeTab = "bans";
        await OpenIpProfile(ip);
    }

    private async Task DoSearch() { currentPage = 1; await LoadData(); }
    private async Task ClearSearch() { searchTerm = ""; currentPage = 1; await LoadData(); }
    private async Task HandleSearchKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoSearch();
    }

    private async Task GoToPage(int page) { currentPage = page; await LoadData(); }
    private async Task FirstPage() { currentPage = 1; await LoadData(); }
    private async Task PrevPage() { if (currentPage > 1) { currentPage--; await LoadData(); } }
    private async Task NextPage() { if (currentPage < totalPages) { currentPage++; await LoadData(); } }
    private async Task LastPage() { currentPage = totalPages; await LoadData(); }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}

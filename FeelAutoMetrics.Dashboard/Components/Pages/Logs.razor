@page "/logs"
@using FeelAutoMetrics.Infrastructure.Data
@using FeelAutoMetrics.Shared.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IConfiguration Configuration
@rendermode InteractiveServer

<PageTitle>FeelAuto-Metrics | Flux Direct</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-white">Flux Global des Logs</h1>
        <div class="d-flex gap-2">
            <a href="@GetExportUrl("logs", "csv")" target="_blank" class="btn btn-outline-success btn-sm">
                <i class="bi bi-filetype-csv me-1"></i>Export CSV Logs
            </a>
            <a href="@GetExportUrl("logs", "json")" target="_blank" class="btn btn-outline-info btn-sm">
                <i class="bi bi-filetype-json me-1"></i>Export JSON Logs
            </a>
            <a href="@GetExportUrl("events", "csv")" target="_blank" class="btn btn-outline-success btn-sm">
                <i class="bi bi-filetype-csv me-1"></i>Export CSV Events
            </a>
            <a href="@GetExportUrl("events", "json")" target="_blank" class="btn btn-outline-info btn-sm">
                <i class="bi bi-filetype-json me-1"></i>Export JSON Events
            </a>
            <button class="btn btn-outline-primary btn-sm" @onclick="RefreshLogs">Actualiser</button>
        </div>
    </div>

    @if (logs == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Chargement...</span>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive bg-dark rounded shadow">
            <table class="table table-dark table-hover mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Domaine</th>
                        <th>Client IP</th>
                        <th>Méthode / Path</th>
                        <th>Statut</th>
                        <th>Localisation</th>
                        <th>Navigateur</th>
                        <th>Durée (ms)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in logs)
                    {
                        <tr class="align-middle">
                            <td class="small text-muted">@log.Timestamp.LocalDateTime.ToString("HH:mm:ss")</td>
                            <td><span class="badge bg-secondary opacity-75">@log.RequestHost</span></td>
                            <td class="text-light small">@log.ClientHost</td>
                            <td class="text-truncate" style="max-width: 300px;">
                                <span class="text-info me-2 fw-bold">@log.RequestMethod</span>
                                <span class="text-white-50 small">@log.RequestPath</span>
                            </td>
                            <td>
                                <span class="badge @GetStatusClass(log.ResponseStatusCode)">@log.ResponseStatusCode</span>
                            </td>
                            <td class="text-light">
                                @if (!string.IsNullOrEmpty(log.CountryCode))
                                {
                                    <span class="fw-bold">@log.CountryCode</span><span class="text-muted mx-1">-</span><span>@log.CityName</span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td class="small text-light">
                                @if (log.IsBot)
                                {
                                    <span class="badge bg-warning text-dark me-1">Bot</span>
                                }
                                @log.BrowserName
                            </td>
                            <td class="text-end fw-bold text-info">@log.DurationMs<small class="text-muted ms-1">ms</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<GlobalAccessLog>? logs;
    private string ingestorBaseUrl = "";

    protected override async Task OnInitializedAsync()
    {
        ingestorBaseUrl = Configuration["IngestorBaseUrl"] ?? "http://localhost:5001";
        await RefreshLogs();
    }

    private async Task RefreshLogs()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        logs = await context.GlobalAccessLogs
            .OrderByDescending(l => l.Timestamp)
            .Take(50)
            .ToListAsync();
    }

    private string GetExportUrl(string type, string format)
    {
        var from = DateTime.UtcNow.AddDays(-30).ToString("yyyy-MM-dd");
        var to = DateTime.UtcNow.ToString("yyyy-MM-dd");
        return $"{ingestorBaseUrl}/api/export/{type}?format={format}&from={from}&to={to}";
    }

    private string GetStatusClass(int status) => status switch
    {
        >= 200 and < 300 => "bg-success",
        >= 300 and < 400 => "bg-info",
        >= 400 and < 500 => "bg-warning",
        >= 500 => "bg-danger",
        _ => "bg-secondary"
    };
}

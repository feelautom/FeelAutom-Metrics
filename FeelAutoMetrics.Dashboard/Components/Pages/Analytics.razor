@page "/analytics"
@using FeelAutoMetrics.Infrastructure.Data
@using FeelAutoMetrics.Shared.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@rendermode InteractiveServer

<PageTitle>FeelAuto-Metrics | Analyses Globales</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-white">Analyses de Performance & Trafic</h1>
        <button class="btn btn-outline-info" @onclick="LoadData">Actualiser</button>
    </div>

    @if (domainStats == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-info" role="status">
                <span class="visually-hidden">Calcul des statistiques...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var stat in domainStats)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card bg-dark border-info text-white shadow h-100">
                        <div class="card-body">
                            <h5 class="card-title text-info mb-3">@stat.Domain</h5>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Total Requêtes</span>
                                <span class="fw-bold">@stat.TotalRequests</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Latence Moyenne</span>
                                <span class="fw-bold">@stat.AverageLatency.ToString("N0") ms</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Erreurs (4xx/5xx)</span>
                                <span class="fw-bold text-warning">@stat.ErrorRate.ToString("P1")</span>
                            </div>
                            <div class="mt-3">
                                <span class="text-muted small">Trafic Bot : @stat.BotRate.ToString("P1")</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<DomainStat>? domainStats;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        
        var rawStats = await context.GlobalAccessLogs
            .GroupBy(l => l.RequestHost)
            .Select(g => new
            {
                Domain = g.Key,
                Count = g.Count(),
                AvgLatency = g.Average(l => l.DurationMs),
                Errors = g.Count(l => l.ResponseStatusCode >= 400),
                Bots = g.Count(l => l.IsBot)
            })
            .ToListAsync();

        domainStats = rawStats.Select(s => new DomainStat
        {
            Domain = s.Domain,
            TotalRequests = s.Count,
            AverageLatency = s.AvgLatency,
            ErrorRate = (double)s.Errors / s.Count,
            BotRate = (double)s.Bots / s.Count
        }).OrderByDescending(s => s.TotalRequests).ToList();
    }

    private class DomainStat
    {
        public string Domain { get; set; } = "";
        public int TotalRequests { get; set; }
        public double AverageLatency { get; set; }
        public double ErrorRate { get; set; }
        public double BotRate { get; set; }
    }
}

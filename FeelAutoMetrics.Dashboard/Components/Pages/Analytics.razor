@page "/analytics"
@using FeelAutoMetrics.Infrastructure.Data
@using FeelAutoMetrics.Shared.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>FeelAutom-Metrics | Analyses Globales</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-white">Analyses de Performance & Trafic</h1>
        <div class="d-flex align-items-center gap-3">
            <span class="text-muted small"><i class="bi bi-arrow-repeat me-1"></i>Auto-refresh 30s</span>
        </div>
    </div>

    @if (domainStats == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-info" role="status">
                <span class="visually-hidden">Calcul des statistiques...</span>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive bg-dark rounded shadow">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr class="text-muted text-uppercase small">
                        <th class="ps-4">Domaine</th>
                        <th class="text-end">Requêtes</th>
                        <th>Répartition</th>
                        <th class="text-end">Latence Moy.</th>
                        <th class="text-end">Erreurs 4xx/5xx</th>
                        <th class="text-end">Bots</th>
                        <th class="text-end">Volume</th>
                        <th class="text-end pe-4">Santé</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stat in domainStats)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="fw-bold text-info">@stat.Domain</span>
                            </td>
                            <td class="text-end fw-bold">@stat.TotalRequests.ToString("N0")</td>
                            <td style="min-width: 160px;">
                                <div class="progress bg-secondary" style="height: 6px;">
                                    <div class="progress-bar bg-info" style="width: @GetTrafficPercentage(stat.TotalRequests)%"></div>
                                </div>
                            </td>
                            <td class="text-end">
                                <span class="@(stat.AverageLatency > 500 ? "text-danger fw-bold" : stat.AverageLatency > 200 ? "text-warning" : "text-light")">
                                    @stat.AverageLatency.ToString("N0") <small class="text-muted">ms</small>
                                </span>
                            </td>
                            <td class="text-end">
                                <span class="badge @(stat.ErrorRate > 0.5 ? "bg-danger" : stat.ErrorRate > 0.1 ? "bg-warning text-dark" : "bg-success")">
                                    @stat.ErrorRate.ToString("P1")
                                </span>
                            </td>
                            <td class="text-end">
                                <span class="text-muted">@stat.BotRate.ToString("P1")</span>
                            </td>
                            <td class="text-end">
                                <span class="text-light">@FormatVolume(stat.TotalVolume)</span>
                            </td>
                            <td class="text-end pe-4">
                                @if (stat.ErrorRate < 0.1)
                                {
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                }
                                else if (stat.ErrorRate < 0.5)
                                {
                                    <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle-fill text-danger"></i>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="border-top border-secondary">
                        <td class="ps-4 text-muted fw-bold">Total (@domainStats.Count domaines)</td>
                        <td class="text-end fw-bold text-white">@domainStats.Sum(s => s.TotalRequests).ToString("N0")</td>
                        <td></td>
                        <td class="text-end text-muted">@(domainStats.Any() ? domainStats.Average(s => s.AverageLatency).ToString("N0") : "0") <small>ms</small></td>
                        <td></td>
                        <td></td>
                        <td class="text-end text-muted fw-bold">@FormatVolume(domainStats.Sum(s => s.TotalVolume))</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>

@code {
    private List<DomainStat>? domainStats;
    private int maxRequests = 1;
    private Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _refreshTimer = new Timer(async _ =>
        {
            await LoadData();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task LoadData()
    {
        using var context = await DbFactory.CreateDbContextAsync();

        var excludedIps = await context.ExcludedIps.Select(e => e.IpAddress).ToListAsync();
        IQueryable<GlobalAccessLog> baseQuery = context.GlobalAccessLogs;
        if (excludedIps.Any())
            baseQuery = baseQuery.Where(l => !excludedIps.Contains(l.ClientHost));

        var rawStats = await baseQuery
            .GroupBy(l => l.RequestHost)
            .Select(g => new
            {
                Domain = g.Key,
                Count = g.Count(),
                AvgLatency = g.Average(l => l.DurationMs),
                Errors = g.Count(l => l.ResponseStatusCode >= 400),
                Bots = g.Count(l => l.IsBot),
                Volume = g.Sum(l => l.ResponseContentSize)
            })
            .ToListAsync();

        domainStats = rawStats.Select(s => new DomainStat
        {
            Domain = s.Domain,
            TotalRequests = s.Count,
            AverageLatency = s.AvgLatency,
            ErrorRate = (double)s.Errors / s.Count,
            BotRate = (double)s.Bots / s.Count,
            TotalVolume = s.Volume
        }).OrderByDescending(s => s.TotalRequests).ToList();

        maxRequests = domainStats.FirstOrDefault()?.TotalRequests ?? 1;
    }

    private double GetTrafficPercentage(int count) => (double)count / maxRequests * 100;

    private static string FormatVolume(long bytes)
    {
        if (bytes >= 1_073_741_824)
            return $"{(bytes / 1_073_741_824.0):N2} GB";
        if (bytes >= 1_048_576)
            return $"{(bytes / 1_048_576.0):N2} MB";
        if (bytes >= 1024)
            return $"{(bytes / 1024.0):N1} KB";
        return $"{bytes} B";
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }

    private class DomainStat
    {
        public string Domain { get; set; } = "";
        public int TotalRequests { get; set; }
        public double AverageLatency { get; set; }
        public double ErrorRate { get; set; }
        public double BotRate { get; set; }
        public long TotalVolume { get; set; }
    }
}

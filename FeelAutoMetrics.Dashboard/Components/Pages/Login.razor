@page "/login"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@layout FeelAutoMetrics.Dashboard.Components.Layout.EmptyLayout
@inject NavigationManager Nav

<PageTitle>FeelAutom-Metrics | Connexion</PageTitle>

<div class="auth-container d-flex align-items-center justify-content-center vh-100 bg-black">
    <div class="card bg-dark text-white border-secondary shadow-lg p-5" style="width: 100%; max-width: 420px; border: 1px solid #222 !important; border-radius: 15px;">
        <div class="text-center mb-5">
            <img src="logo.svg" alt="FeelAutom-Metrics" width="56" height="56" class="mb-3" />
            <h1 class="h3 fw-bold text-primary mb-2" style="letter-spacing: -1px; border: none !important; outline: none !important;">FeelAutom-Metrics</h1>
            <p class="text-muted small opacity-75">Accès réservé à l'administration technique.</p>
        </div>

        @if (Nav.Uri.Contains("error=true"))
        {
            <div class="alert alert-danger small py-2 border-0 bg-danger bg-opacity-10 text-danger text-center mb-4">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>Mot de passe incorrect.
            </div>
        }

        <form method="post" action="api/auth/login">
            <AntiforgeryToken />
            <div class="mb-4">
                <label class="form-label small text-muted text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 1px;">Mot de passe d'accès</label>
                <input type="password" name="password" class="form-control bg-black border-secondary text-white p-3 shadow-none"
                       style="border-color: #333 !important; transition: border-color 0.3s;"
                       placeholder="••••••••" required />
            </div>

            <button type="submit" class="btn btn-primary w-100 p-3 fw-bold shadow-sm" style="border-radius: 8px;">Se connecter</button>
        </form>
        
        <div class="text-center mt-5 small text-muted opacity-50">
            &copy; @DateTime.Now.Year FeelAutom - Observabilité
        </div>
    </div>
</div>

<style>
    .auth-container {
        background: radial-gradient(circle at center, #1a1a1a 0%, #000 100%);
    }
    .form-control:focus {
        background-color: #000;
        border-color: var(--bs-primary);
        color: white;
        box-shadow: none;
    }
</style>

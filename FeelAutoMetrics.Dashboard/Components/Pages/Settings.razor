@page "/settings"
@using FeelAutoMetrics.Infrastructure.Data
@using FeelAutoMetrics.Shared.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@rendermode InteractiveServer

<PageTitle>FeelAuto-Metrics | Paramètres</PageTitle>

<div class="container-fluid py-4">
    <h1 class="h3 text-white mb-4"><i class="bi bi-gear-fill me-2"></i>Paramètres</h1>

    <!-- Excluded IPs -->
    <div class="card bg-dark border-secondary text-white shadow mb-4">
        <div class="card-header bg-transparent border-secondary py-3">
            <h5 class="mb-0"><i class="bi bi-eye-slash me-2"></i>IPs Exclues du Trafic</h5>
            <small class="text-muted">Ces adresses IP seront masquées dans toutes les vues (Dashboard, Logs, Analyses, Sécurité).</small>
        </div>
        <div class="card-body">
            <!-- Add form -->
            <div class="d-flex gap-2 mb-4">
                <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                       placeholder="Adresse IP (ex: 82.65.12.34)" @bind="newIp" @bind:event="oninput"
                       @onkeydown="OnKeyDown" style="max-width: 250px;" />
                <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                       placeholder="Label (ex: Mon bureau, VPN...)" @bind="newLabel" @bind:event="oninput"
                       @onkeydown="OnKeyDown" style="max-width: 250px;" />
                <button class="btn btn-primary btn-sm" @onclick="AddExcludedIp" disabled="@string.IsNullOrWhiteSpace(newIp)">
                    <i class="bi bi-plus-lg me-1"></i>Ajouter
                </button>
            </div>

            @if (excludedIps == null)
            {
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
            }
            else if (!excludedIps.Any())
            {
                <p class="text-muted mb-0">Aucune IP exclue. Ajoutez votre IP pour masquer votre propre trafic.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Adresse IP</th>
                                <th>Label</th>
                                <th>Ajoutée le</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ip in excludedIps)
                            {
                                <tr class="align-middle">
                                    <td class="font-monospace text-info fw-bold">@ip.IpAddress</td>
                                    <td class="text-muted">@(ip.Label ?? "-")</td>
                                    <td class="small text-muted">@ip.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-end">
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => RemoveExcludedIp(ip.Id)">
                                            <i class="bi bi-trash me-1"></i>Supprimer
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1050;">
        <div class="toast show bg-dark border-@statusClass text-white shadow-lg">
            <div class="toast-body">
                <i class="bi @statusIcon me-2"></i>@statusMessage
            </div>
        </div>
    </div>
}

@code {
    private List<ExcludedIp>? excludedIps;
    private string newIp = "";
    private string newLabel = "";
    private string? statusMessage;
    private string statusClass = "success";
    private string statusIcon = "bi-check-circle-fill";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        excludedIps = await context.ExcludedIps
            .OrderByDescending(e => e.CreatedAt)
            .ToListAsync();
    }

    private async Task AddExcludedIp()
    {
        var ip = newIp.Trim();
        if (string.IsNullOrWhiteSpace(ip)) return;

        using var context = await DbFactory.CreateDbContextAsync();
        if (await context.ExcludedIps.AnyAsync(e => e.IpAddress == ip))
        {
            await ShowStatus($"{ip} est déjà dans la liste.", "warning", "bi-exclamation-triangle-fill");
            return;
        }

        context.ExcludedIps.Add(new ExcludedIp
        {
            IpAddress = ip,
            Label = string.IsNullOrWhiteSpace(newLabel) ? null : newLabel.Trim()
        });
        await context.SaveChangesAsync();

        newIp = "";
        newLabel = "";
        await LoadData();
        await ShowStatus($"{ip} exclu du trafic.", "success", "bi-check-circle-fill");
    }

    private async Task RemoveExcludedIp(Guid id)
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var entry = await context.ExcludedIps.FindAsync(id);
        if (entry != null)
        {
            context.ExcludedIps.Remove(entry);
            await context.SaveChangesAsync();
            await ShowStatus($"{entry.IpAddress} réintégré dans le trafic.", "info", "bi-eye-fill");
        }
        await LoadData();
    }

    private async Task OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddExcludedIp();
    }

    private async Task ShowStatus(string message, string cssClass, string icon)
    {
        statusMessage = message;
        statusClass = cssClass;
        statusIcon = icon;
        StateHasChanged();
        await Task.Delay(3000);
        statusMessage = null;
        StateHasChanged();
    }
}

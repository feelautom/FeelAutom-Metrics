@page "/settings"
@using FeelAutoMetrics.Infrastructure.Data
@using FeelAutoMetrics.Shared.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@using FeelAutoMetrics.Infrastructure.Services
@inject IConfiguration Configuration
@rendermode InteractiveServer

<PageTitle>FeelAutom-Metrics | Paramètres</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-white mb-0"><i class="bi bi-gear-fill me-2 text-primary"></i>Paramètres Système</h1>
        <div class="text-muted small">Version @Configuration["Version"]</div>
    </div>

    <!-- Tabs Navigation -->
    <ul class="nav nav-tabs border-secondary mb-0">
        <li class="nav-item">
            <button class="nav-link @(activeTab == "ai" ? "active text-primary" : "text-muted")" @onclick='() => activeTab = "ai"'>
                <i class="bi bi-robot me-2"></i>Analyste IA
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "excluded" ? "active text-info" : "text-muted")" @onclick='() => activeTab = "excluded"'>
                <i class="bi bi-eye-slash me-2"></i>Exclusions d'IPs
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "db" ? "active text-warning" : "text-muted")" @onclick='() => activeTab = "db"'>
                <i class="bi bi-database me-2"></i>Maintenance BDD
            </button>
        </li>
    </ul>

    <div class="card bg-dark border-secondary text-white shadow border-top-0 mb-4" style="border-top-left-radius: 0; border-top-right-radius: 0;">
        <div class="card-body p-4">

            @* ===== TAB: ANALYSTE IA ===== *@
            @if (activeTab == "ai")
            {
                <div class="row mb-4">
                    <div class="col-md-8">
                        <h5 class="text-white mb-1"><i class="bi bi-robot me-2 text-primary"></i>Analyste SOC Intelligent</h5>
                        <p class="text-muted small">Configuration des instructions envoyées à Gemini pour l'analyse des menaces.</p>
                    </div>
                    <div class="col-md-4 text-end">
                        @if (aiEnabled)
                        {
                            <span class="badge bg-success p-2"><i class="bi bi-check-circle me-1"></i>IA Opérationnelle</span>
                        }
                        else
                        {
                            <span class="badge bg-danger p-2"><i class="bi bi-x-circle me-1"></i>IA Désactivée</span>
                        }
                    </div>
                </div>

                <div class="row mb-4 g-3">
                    <div class="col-md-4">
                        <div class="bg-black p-3 rounded border border-secondary h-100">
                            <label class="text-muted small text-uppercase fw-bold mb-2">Fréquence d'analyse</label>
                            <div class="h5 mb-0 text-white">@aiInterval minutes</div>
                            <small class="text-muted">Délai entre deux scans de logs.</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="bg-black p-3 rounded border border-secondary h-100">
                            <label class="text-muted small text-uppercase fw-bold mb-2">Modèle Actif</label>
                            <div class="h5 mb-0 text-info">@aiModel</div>
                            <small class="text-muted">Moteur d'intelligence artificielle.</small>

                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="bg-black p-3 rounded border border-secondary h-100">
                            <label class="text-muted small text-uppercase fw-bold mb-2">Auto-Ban</label>
                            <div class="h5 mb-0 text-warning">Activé</div>
                            <small class="text-muted">Décisions appliquées automatiquement.</small>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-end mb-2">
                        <label class="text-muted small text-uppercase fw-bold">Instructions Système (Prompt Template)</label>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="ResetAiPrompt" disabled="@savingPrompt">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>Défaut
                            </button>
                            <button class="btn btn-primary btn-sm" @onclick="SaveAiPrompt" disabled="@savingPrompt">
                                @if (savingPrompt)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                else
                                {
                                    <i class="bi bi-save me-1"></i>
                                }
                                Enregistrer
                            </button>
                        </div>
                    </div>
                    <textarea class="form-control bg-black text-success font-monospace p-3 border-secondary" 
                              rows="18" @bind="aiPrompt" style="font-size: 0.85rem; resize: vertical;"></textarea>
                    
                    <div class="mt-3 p-3 bg-black rounded border border-secondary">
                        <h6 class="small text-muted text-uppercase fw-bold mb-2">Placeholders disponibles :</h6>
                        <div class="d-flex flex-wrap gap-2">
                            <code class="text-info bg-dark px-2 rounded">@("{{BANS}}")</code>
                            <code class="text-info bg-dark px-2 rounded">@("{{WHITELIST}}")</code>
                            <code class="text-info bg-dark px-2 rounded">@("{{SCORES}}")</code>
                            <code class="text-info bg-dark px-2 rounded">@("{{THREATS}}")</code>
                            <code class="text-info bg-dark px-2 rounded">@("{{SEUIL}}")</code>
                        </div>
                        <small class="text-muted mt-2 d-block">
                            <i class="bi bi-info-circle me-1"></i>Ces variables seront remplacées par les données réelles lors de l'appel à l'IA.
                        </small>
                    </div>
                </div>
            }

            @* ===== TAB: EXCLUDED IPS ===== *@
            @if (activeTab == "excluded")
            {
                <div class="mb-4">
                    <h5 class="text-white mb-1"><i class="bi bi-eye-slash me-2 text-info"></i>IPs Exclues du Trafic</h5>
                    <p class="text-muted small">Ces adresses IP seront masquées dans toutes les vues (Dashboard, Logs, Analyses, Sécurité).</p>
                </div>

                <!-- Add form -->
                <div class="d-flex gap-2 mb-4 bg-black p-3 rounded border border-secondary">
                    <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                           placeholder="Adresse IP (ex: 82.65.12.34)" @bind="newIp" @bind:event="oninput"
                           @onkeydown="OnKeyDown" style="max-width: 250px;" />
                    <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                           placeholder="Label (ex: Mon bureau, VPN...)" @bind="newLabel" @bind:event="oninput"
                           @onkeydown="OnKeyDown" style="max-width: 250px;" />
                    <button class="btn btn-info btn-sm" @onclick="AddExcludedIp" disabled="@string.IsNullOrWhiteSpace(newIp)">
                        <i class="bi bi-plus-lg me-1"></i>Ajouter l'exclusion
                    </button>
                </div>

                @if (excludedIps == null)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border text-info" role="status"></div>
                    </div>
                }
                else if (!excludedIps.Any())
                {
                    <div class="alert alert-dark border-secondary text-center py-4">
                        <i class="bi bi-info-circle me-2"></i>Aucune IP exclue. Ajoutez votre IP pour masquer votre propre trafic.
                    </div>
                }
                else
                {
                    <div class="table-responsive rounded border border-secondary">
                        <table class="table table-dark table-hover mb-0">
                            <thead>
                                <tr class="text-muted small text-uppercase">
                                    <th class="ps-3">Adresse IP</th>
                                    <th>Label / Identification</th>
                                    <th>Ajoutée le</th>
                                    <th class="text-end pe-3">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ip in excludedIps)
                                {
                                    <tr class="align-middle">
                                        <td class="ps-3 font-monospace text-info fw-bold">@ip.IpAddress</td>
                                        <td>@(ip.Label ?? "-")</td>
                                        <td class="small text-muted">@ip.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-end pe-3">
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => RemoveExcludedIp(ip.Id)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            @* ===== TAB: DATABASE ===== *@
            @if (activeTab == "db")
            {
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h5 class="text-white mb-1"><i class="bi bi-database me-2 text-warning"></i>Maintenance de la Base de Données</h5>
                        <p class="text-muted small mb-0">Analyse de la volumétrie et purge des anciennes données.</p>
                    </div>
                    <button class="btn btn-outline-warning btn-sm" @onclick="LoadDbStats" disabled="@dbLoading">
                        <i class="bi bi-arrow-repeat me-1 @(dbLoading ? "spin" : "")"></i>Actualiser
                    </button>
                </div>

                @if (dbStats == null)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border text-warning" role="status"></div>
                    </div>
                }
                else
                {
                    <div class="row mb-4 g-3">
                        <div class="col-md-3">
                            <div class="bg-black p-3 rounded border border-secondary h-100 text-center">
                                <div class="text-muted text-uppercase small mb-1">Taille Totale</div>
                                <h3 class="mb-0 @(dbStats.TotalSizeMb > 500 ? "text-danger" : dbStats.TotalSizeMb > 200 ? "text-warning" : "text-success")">
                                    @FormatSize(dbStats.TotalSizeBytes)
                                </h3>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="bg-black p-3 rounded border border-secondary h-100 text-center">
                                <div class="text-muted text-uppercase small mb-1">Logs Réseau</div>
                                <h3 class="mb-0 text-white">@dbStats.LogCount.ToString("N0")</h3>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="bg-black p-3 rounded border border-secondary h-100 text-center">
                                <div class="text-muted text-uppercase small mb-1">Événements App</div>
                                <h3 class="mb-0 text-white">@dbStats.EventCount.ToString("N0")</h3>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="bg-black p-3 rounded border border-secondary h-100 text-center">
                                <div class="text-muted text-uppercase small mb-1">Scores de Menace</div>
                                <h3 class="mb-0 text-white">@dbStats.ThreatScoreCount.ToString("N0")</h3>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive rounded border border-secondary mb-4">
                        <table class="table table-dark table-sm mb-0 align-middle">
                            <thead>
                                <tr class="text-muted text-uppercase small">
                                    <th class="ps-3">Table</th>
                                    <th class="text-end">Lignes</th>
                                    <th class="text-end">Taille</th>
                                    <th class="pe-3">Utilisation</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in dbStats.Tables)
                                {
                                    <tr>
                                        <td class="ps-3 font-monospace text-warning">@t.Name</td>
                                        <td class="text-end">@t.RowCount.ToString("N0")</td>
                                        <td class="text-end fw-bold">@FormatSize(t.SizeBytes)</td>
                                        <td class="pe-3" style="min-width: 150px;">
                                            <div class="progress bg-dark" style="height: 6px;">
                                                <div class="progress-bar bg-warning" style="width: @(dbStats.TotalSizeBytes > 0 ? (double)t.SizeBytes / dbStats.TotalSizeBytes * 100 : 0)%"></div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="p-3 bg-black rounded border border-secondary">
                        <h6 class="text-muted text-uppercase small mb-3"><i class="bi bi-trash me-2 text-warning"></i>Nettoyage des données</h6>
                        <div class="row align-items-center g-3">
                            <div class="col-auto">
                                <span class="text-muted small">Purger les logs et événements de plus de</span>
                            </div>
                            <div class="col-auto">
                                <select class="form-select form-select-sm bg-dark text-white border-secondary" style="width: 120px;"
                                        @bind="purgeDays">
                                    <option value="7">7 jours</option>
                                    <option value="14">14 jours</option>
                                    <option value="30">30 jours</option>
                                    <option value="60">60 jours</option>
                                    <option value="90">90 jours</option>
                                </select>
                            </div>
                            <div class="col-auto">
                                <button class="btn btn-warning btn-sm" @onclick="PurgeLogs" disabled="@purging">
                                    @if (purging)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                        <span>Purge en cours...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-trash me-1"></i>
                                        <span>Exécuter la purge</span>
                                    }
                                </button>
                            </div>
                        </div>
                        <div class="mt-3 small text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            @if (dbStats.OldestLog != null)
                            {
                                <span>Rétention actuelle : <strong>@((DateTimeOffset.UtcNow - dbStats.OldestLog.Value).Days) jours</strong> (depuis le @dbStats.OldestLog.Value.LocalDateTime.ToString("dd/MM/yy")).</span>
                            }
                            Le système purge automatiquement les données de plus de 60 jours chaque nuit.
                        </div>
                    </div>
                }
            }

        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1050;">
        <div class="toast show bg-dark border-@statusClass text-white shadow-lg">
            <div class="toast-body">
                <i class="bi @statusIcon me-2"></i>@statusMessage
            </div>
        </div>
    </div>
}

@code {
    private List<ExcludedIp>? excludedIps;
    private string newIp = "";
    private string newLabel = "";
    private string? statusMessage;
    private string statusClass = "success";
    private string statusIcon = "bi-check-circle-fill";
    private string activeTab = "ai";

    // AI Analyst
    private bool aiEnabled;
    private int aiInterval;
    private string aiModel = "";
    private string aiPrompt = "";
    private bool savingPrompt;

    // DB Stats
    private DbStatsModel? dbStats;
    private bool dbLoading;
    private int purgeDays = 30;
    private bool purging;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await LoadDbStats();
        await LoadAiSettings();
    }

    private async Task LoadAiSettings()
    {
        aiEnabled = !string.IsNullOrEmpty(Configuration["AiAnalyst:GeminiApiKey"]);
        aiModel = Configuration["AiAnalyst:Model"] ?? "gemini-3.1-pro-preview";
        var intervalStr = Configuration["AiAnalyst:IntervalMinutes"];
        aiInterval = int.TryParse(intervalStr, out var iv) ? iv : 15;
        
        using var context = await DbFactory.CreateDbContextAsync();
        var customPrompt = await context.SystemSettings
            .Where(s => s.Key == "AiSystemPrompt")
            .Select(s => s.Value)
            .FirstOrDefaultAsync();
            
        aiPrompt = !string.IsNullOrEmpty(customPrompt) ? customPrompt : AiAnalystService.GetSystemPromptTemplate();
    }

    private async Task SaveAiPrompt()
    {
        savingPrompt = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var setting = await context.SystemSettings.FirstOrDefaultAsync(s => s.Key == "AiSystemPrompt");
            
            if (setting == null)
            {
                context.SystemSettings.Add(new SystemSetting { Key = "AiSystemPrompt", Value = aiPrompt });
            }
            else
            {
                setting.Value = aiPrompt;
                setting.LastModified = DateTimeOffset.UtcNow;
            }
            
            await context.SaveChangesAsync();
            await ShowStatus("Prompt IA sauvegardé avec succès.", "success", "bi-check-circle-fill");
        }
        catch (Exception ex)
        {
            await ShowStatus($"Erreur lors de la sauvegarde : {ex.Message}", "danger", "bi-x-circle-fill");
        }
        finally
        {
            savingPrompt = false;
        }
    }

    private async Task ResetAiPrompt()
    {
        aiPrompt = AiAnalystService.GetSystemPromptTemplate();
        await ShowStatus("Template par défaut restauré (cliquez sur Enregistrer pour confirmer).", "info", "bi-info-circle");
    }

    private async Task LoadData()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        excludedIps = await context.ExcludedIps
            .OrderByDescending(e => e.CreatedAt)
            .ToListAsync();
    }

    private async Task LoadDbStats()
    {
        dbLoading = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var stats = new DbStatsModel();

            // Taille totale de la base
            try
            {
                var conn = context.Database.GetDbConnection();
                await conn.OpenAsync();
                using var cmd = conn.CreateCommand();
                cmd.CommandText = "SELECT pg_database_size(current_database())";
                var result = await cmd.ExecuteScalarAsync();
                stats.TotalSizeBytes = Convert.ToInt64(result);

                // Taille par table
                cmd.CommandText = @"
                    SELECT relname as table_name,
                           n_live_tup as row_count,
                           pg_total_relation_size(quote_ident(relname)) as total_size
                    FROM pg_stat_user_tables
                    ORDER BY pg_total_relation_size(quote_ident(relname)) DESC";
                using var reader = await cmd.ExecuteReaderAsync();
                while (await reader.ReadAsync())
                {
                    stats.Tables.Add(new TableStats
                    {
                        Name = reader.GetString(0),
                        RowCount = reader.GetInt64(1),
                        SizeBytes = reader.GetInt64(2)
                    });
                }
            }
            catch { /* Fallback si les requêtes pg_stat échouent */ }

            stats.LogCount = await context.GlobalAccessLogs.CountAsync();
            stats.EventCount = await context.AppEvents.CountAsync();
            stats.ThreatScoreCount = await context.IpThreatScores.CountAsync();

            var oldest = await context.GlobalAccessLogs
                .OrderBy(l => l.Timestamp)
                .Select(l => (DateTimeOffset?)l.Timestamp)
                .FirstOrDefaultAsync();
            stats.OldestLog = oldest;

            stats.TotalSizeMb = stats.TotalSizeBytes / 1_048_576.0;

            dbStats = stats;
        }
        finally
        {
            dbLoading = false;
        }
    }

    private async Task PurgeLogs()
    {
        purging = true;
        StateHasChanged();
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var cutoff = DateTimeOffset.UtcNow.AddDays(-purgeDays);

            var deletedLogs = await context.GlobalAccessLogs
                .Where(l => l.Timestamp < cutoff)
                .ExecuteDeleteAsync();

            var deletedEvents = await context.AppEvents
                .Where(e => e.Timestamp < cutoff)
                .ExecuteDeleteAsync();

            await LoadDbStats();
            await ShowStatus($"Purge terminée : {deletedLogs:N0} logs et {deletedEvents:N0} événements supprimés.", "success", "bi-check-circle-fill");
        }
        catch (Exception ex)
        {
            await ShowStatus($"Erreur lors de la purge : {ex.Message}", "danger", "bi-x-circle-fill");
        }
        finally
        {
            purging = false;
        }
    }

    private static string FormatSize(long bytes)
    {
        if (bytes >= 1_073_741_824) return $"{bytes / 1_073_741_824.0:N2} GB";
        if (bytes >= 1_048_576) return $"{bytes / 1_048_576.0:N1} MB";
        if (bytes >= 1024) return $"{bytes / 1024.0:N0} KB";
        return $"{bytes} B";
    }

    private async Task AddExcludedIp()
    {
        var ip = newIp.Trim();
        if (string.IsNullOrWhiteSpace(ip)) return;

        using var context = await DbFactory.CreateDbContextAsync();
        if (await context.ExcludedIps.AnyAsync(e => e.IpAddress == ip))
        {
            await ShowStatus($"{ip} est déjà dans la liste.", "warning", "bi-exclamation-triangle-fill");
            return;
        }

        context.ExcludedIps.Add(new ExcludedIp
        {
            IpAddress = ip,
            Label = string.IsNullOrWhiteSpace(newLabel) ? null : newLabel.Trim()
        });
        await context.SaveChangesAsync();

        newIp = "";
        newLabel = "";
        await LoadData();
        await ShowStatus($"{ip} exclu du trafic.", "success", "bi-check-circle-fill");
    }

    private async Task RemoveExcludedIp(Guid id)
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var entry = await context.ExcludedIps.FindAsync(id);
        if (entry != null)
        {
            context.ExcludedIps.Remove(entry);
            await context.SaveChangesAsync();
            await ShowStatus($"{entry.IpAddress} réintégré dans le trafic.", "info", "bi-eye-fill");
        }
        await LoadData();
    }

    private async Task OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddExcludedIp();
    }

    private async Task ShowStatus(string message, string cssClass, string icon)
    {
        statusMessage = message;
        statusClass = cssClass;
        statusIcon = icon;
        StateHasChanged();
        await Task.Delay(3000);
        statusMessage = null;
        StateHasChanged();
    }

    private class DbStatsModel
    {
        public long TotalSizeBytes { get; set; }
        public double TotalSizeMb { get; set; }
        public int LogCount { get; set; }
        public int EventCount { get; set; }
        public int ThreatScoreCount { get; set; }
        public DateTimeOffset? OldestLog { get; set; }
        public List<TableStats> Tables { get; set; } = new();
    }

    private class TableStats
    {
        public string Name { get; set; } = "";
        public long RowCount { get; set; }
        public long SizeBytes { get; set; }
    }
}
